    <script>
        function shareCurrentPage() {
            if (navigator.share) {
                // Wenn Web Share API verfügbar ist (hauptsächlich auf Mobilgeräten)
                navigator.share({
                    title: document.title,
                    url: window.location.href
                }).catch(console.error);
            } else {
                // Fallback: URL in die Zwischenablage kopieren
                navigator.clipboard.writeText(window.location.href).then(function() {
                    alert('Link wurde in die Zwischenablage kopiert!');
                }, function(err) {
                    // Weitere Fallback-Option
                    prompt('Link kopieren:', window.location.href);
                });
            }
        }

        // Team Filter Functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Hide buttons when scrolling near footer
            function handleButtonVisibility() {
                const footer = document.querySelector('footer');
                const shareButton = document.querySelector('.share-button');
                const feedbackButton = document.querySelector('.feedback-button');
                
                if (footer && (shareButton || feedbackButton)) {
                    const footerRect = footer.getBoundingClientRect();
                    const windowHeight = window.innerHeight;
                    
                    // Hide buttons when footer is visible (with 100px buffer)
                    const shouldHide = footerRect.top < windowHeight + 100;
                    
                    if (shareButton) {
                        shareButton.classList.toggle('buttons-hidden', shouldHide);
                    }
                    if (feedbackButton) {
                        feedbackButton.classList.toggle('buttons-hidden', shouldHide);
                    }
                }
            }
            
            // Listen to scroll events
            window.addEventListener('scroll', handleButtonVisibility);
            window.addEventListener('resize', handleButtonVisibility);
            
            // Initial check
            handleButtonVisibility();

            const teamFilter = document.getElementById('teamFilter');
            const clearFilter = document.getElementById('clearFilter');
            const gameRows = document.querySelectorAll('table tbody tr[data-team1]');

            function filterGames() {
                const selectedTeam = teamFilter.value;
                
                gameRows.forEach(row => {
                    const team1 = row.getAttribute('data-team1');
                    const team2 = row.getAttribute('data-team2');
                    
                    // Show row if no filter is selected OR if selected team is either team1 OR team2
                    if (selectedTeam === '' || team1 === selectedTeam || team2 === selectedTeam) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
                
                // Update clear button visibility
                clearFilter.style.display = selectedTeam === '' ? 'none' : 'inline-block';
            }

            // Ensure "All games" is selected on page load
            teamFilter.value = '';

            teamFilter.addEventListener('change', filterGames);
            
            clearFilter.addEventListener('click', function() {
                teamFilter.value = '';
                filterGames();
            });
            
            // Initial filter state - show all games
            filterGames();
        });
    </script>
</body>