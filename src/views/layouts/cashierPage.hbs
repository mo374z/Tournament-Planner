<script src="https://cdn.socket.io/4.3.1/socket.io.min.js"></script>
<style>
    .product-card {
        cursor: pointer;
        transition: all 0.2s;
        border: 3px solid #dee2e6;
        min-height: 100px;
    }
    
    .product-card:hover, .product-card:active {
        transform: scale(1.02);
        box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        border-color: #0d6efd;
    }
    
    .product-card .card-body {
        padding: 1.5rem;
    }
    
    .product-card h6 {
        font-size: 1.3rem;
        font-weight: bold;
    }
    
    .product-card .text-primary {
        font-size: 1.2rem;
    }
    
    .product-card.selected {
        border-color: #0d6efd;
        background-color: #e7f3ff;
    }
    
    .quantity-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
    }
    
    .quantity-btn {
        width: 50px;
        height: 50px;
        font-size: 1.5rem;
        border-radius: 8px;
    }
    
    .quantity-display {
        font-size: 2rem;
        font-weight: bold;
        min-width: 60px;
        text-align: center;
    }
    
    .cart-container {
        position: sticky;
        top: 20px;
        max-height: 80vh;
        overflow-y: auto;
        border: 2px solid #dee2e6;
        border-radius: 10px;
        background: white;
    }
    
    .cart-item {
        border-bottom: 1px solid #dee2e6;
        padding: 15px;
        font-size: 1.1rem;
    }
    
    .cart-item:last-child {
        border-bottom: none;
    }
    
    .cart-item strong {
        font-size: 1.2rem;
    }
    
    .cart-item .btn {
        min-width: 45px;
        min-height: 45px;
        font-size: 1.3rem;
    }
    
    .team-select {
        font-size: 1.1rem;
        padding: 10px;
        border: 2px solid #0d6efd;
    }
    
    .team-selection-modal .modal-dialog {
        max-width: 1200px;
    }
    
    .team-selection-modal .modal-title {
        font-size: 1.8rem;
    }
    
    .team-selection-modal h6 {
        font-size: 1.4rem;
        font-weight: bold;
    }
    
    .team-card {
        cursor: pointer;
        transition: all 0.2s;
        border: 4px solid #dee2e6;
        margin-bottom: 20px;
        font-size: 1.6rem;
        min-height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .team-card:hover {
        background-color: #e7f3ff;
        border-color: #0d6efd;
        transform: translateX(5px);
    }
    
    .team-card .card-body {
        padding: 1.5rem 2rem;
        width: 100%;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .no-team-card {
        background-color: #fff3cd;
        border-color: #ffc107;
        font-weight: bold;
        min-height: 130px;
    }
    
    .no-team-card:hover {
        background-color: #ffecb3;
    }
    
    .no-team-card h5 {
        font-size: 2.2rem;
        margin: 0;
    }
    
    .selected-team-banner {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 15px;
        border-radius: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .products-section {
        display: none;
    }
    
    .products-section.active {
        display: block;
    }
    
    .cart-container .p-3 h5 {
        font-size: 1.5rem;
    }
    
    .cart-container .p-3 p {
        font-size: 1.3rem;
    }
    
    #payButton {
        font-size: 1.4rem;
        padding: 15px;
        min-height: 70px;
    }
    
    .selected-team-banner h4 {
        font-size: 1.5rem;
    }
    
    .selected-team-banner .btn {
        font-size: 1.1rem;
        padding: 10px 20px;
    }
    
    h1 {
        font-size: 2.5rem;
    }
    
    h3 {
        font-size: 1.8rem;
        margin-bottom: 1.5rem;
    }
    
    @media (max-width: 768px) {
        .cart-container {
            position: relative;
            margin-top: 30px;
        }
    }
    
    /* Custom Success Modal */
    .success-modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        z-index: 2000;
        justify-content: center;
        align-items: center;
    }
    
    .success-modal-overlay.active {
        display: flex;
    }
    
    .success-modal {
        background: white;
        border-radius: 20px;
        padding: 40px;
        max-width: 600px;
        width: 90%;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        text-align: center;
        animation: modalSlideIn 0.3s ease-out;
    }
    
    @keyframes modalSlideIn {
        from {
            transform: translateY(-50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    
    .success-modal h2 {
        color: #28a745;
        font-size: 2.5rem;
        margin-bottom: 20px;
    }
    
    .success-modal p {
        font-size: 1.5rem;
        margin-bottom: 30px;
        color: #333;
    }
    
    .success-modal .modal-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .success-modal button {
        font-size: 1.3rem;
        padding: 15px 30px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s;
        min-width: 200px;
    }
    
    .success-modal button:hover {
        transform: scale(1.05);
    }
    
    .btn-change-team {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }
    
    .btn-same-team {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
    }
</style>

<div class="container-fluid">
    <h1 class="text-center mb-4">🍺 Kassen-System</h1>
    <hr>
    
    <!-- Gewähltes Team Banner -->
    <div id="selectedTeamBanner" class="selected-team-banner" style="display: none;">
        <div>
            <h4 class="mb-0">Ausgewähltes Team: <span id="selectedTeamName"></span></h4>
        </div>
        <button class="btn btn-light" onclick="openTeamModal()">
            🔄 Team ändern
        </button>
    </div>
    
    <!-- Produktauswahl (zunächst versteckt) -->
    <div id="productsSection" class="products-section">
        <div class="row">
        <!-- Linke Seite: Produktauswahl -->
        <div class="col-md-8">
            <!-- Getränke -->
            <h3>🍺 Getränke</h3>
            <div class="row g-4 mb-5">
                {{#each products.drinks}}
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card" data-product-id="{{this.id}}" data-product-name="{{this.name}}" data-product-price="{{this.price}}" data-product-points="{{this.points}}" onclick="selectProduct('{{this.id}}', '{{this.name}}', {{this.price}}, {{this.points}})">
                        <div class="card-body text-center p-3">
                            <h6 class="card-title mb-2">{{this.name}}</h6>
                            <p class="text-primary mb-0"><strong>{{this.price}} €</strong></p>
                            {{#if this.points}}
                            <small class="text-success">({{this.points}} Pkt)</small>
                            {{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
            
            <!-- Essen -->
            <h3>🍴 Essen</h3>
            <div class="row g-4">
                {{#each products.food}}
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card" data-product-id="{{this.id}}" data-product-name="{{this.name}}" data-product-price="{{this.price}}" data-product-points="0" onclick="selectProduct('{{this.id}}', '{{this.name}}', {{this.price}}, 0)">
                        <div class="card-body text-center p-3">
                            <h6 class="card-title mb-2">{{this.name}}</h6>
                            <p class="text-primary mb-0"><strong>{{this.price}} €</strong></p>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        
        <!-- Rechte Seite: Warenkorb -->
        <div class="col-md-4">
            <div class="cart-container">
                <div class="p-3 bg-primary text-white">
                    <h4 class="mb-0">🛒 Aktuelle Bestellung</h4>
                </div>
                
                <div id="cartItems" class="p-3">
                    <p class="text-muted text-center">Noch keine Artikel</p>
                </div>
                
                <div class="p-3 border-top bg-light">
                    <h5>Gesamt: <span id="totalPrice" class="text-primary">0.00 €</span></h5>
                    <p class="mb-2 text-success"><strong><span id="totalPoints">0 Punkte</span></strong></p>
                    <button id="payButton" class="btn btn-success btn-lg w-100 mt-2" onclick="completePurchase()" disabled>
                        ✓ Bezahlt
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Team-Auswahl Modal -->
<div class="modal fade team-selection-modal" id="teamModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Team auswählen</h5>
            </div>
            <div class="modal-body">
                <!-- Kein Team -->
                <div class="card team-card no-team-card" onclick="selectTeam('no_team', 'Kein Team')">
                    <div class="card-body">
                        <h5 class="mb-0">🚫 Kein Team</h5>
                    </div>
                </div>
                
                <hr>
                
                <!-- Teams nach Gruppen -->
                <div class="row">
                    {{#each teamsByGroup}}
                    <div class="col-md-3">
                        <h6 class="text-center mb-3 text-primary">Gruppe {{@key}}</h6>
                        {{#each this}}
                        <div class="card team-card" onclick="selectTeam('{{this._id}}', '{{this.name}}', '{{this.group}}')">
                            <div class="card-body">
                                <span>{{this.name}}</span>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="success-modal-overlay">
    <div class="success-modal">
        <h2 id="modalIcon">✅</h2>
        <h3 id="modalTitle">Bestellung erfolgreich!</h3>
        <p id="modalMessage"></p>
        <div class="modal-buttons">
            <button class="btn-change-team" onclick="changeTeamAfterOrder()">🔄 Team ändern</button>
            <button class="btn-same-team" onclick="keepCurrentTeam()">✓ Bei Team <span id="modalTeamName"></span> bleiben</button>
        </div>
    </div>
</div>

<script>
    const socket = io('{{socketConfig.protocol}}://{{socketConfig.host}}:{{socketConfig.socketPort}}');
    
    let selectedProduct = null;
    let quantity = 1;
    let cart = [];
    let totalPrice = 0;
    let totalPoints = 0;
    let currentTeam = { id: null, name: null, group: null };
    
    socket.on('connect', () => {
        console.log('Socket connected to server');
    });
    
    // Modal Funktionen
    function showSuccessModal(title, message) {
        document.getElementById('modalTitle').textContent = title;
        document.getElementById('modalMessage').textContent = message;
        document.getElementById('modalTeamName').textContent = '"' + currentTeam.name + '"';
        document.getElementById('successModal').classList.add('active');
    }
    
    function hideSuccessModal() {
        document.getElementById('successModal').classList.remove('active');
    }
    
    function changeTeamAfterOrder() {
        hideSuccessModal();
        currentTeam = { id: null, name: null, group: null };
        document.getElementById('selectedTeamBanner').style.display = 'none';
        document.getElementById('productsSection').classList.remove('active');
        openTeamModal();
    }
    
    function keepCurrentTeam() {
        hideSuccessModal();
    }
    
    // Zeige Modal beim Laden der Seite
    document.addEventListener('DOMContentLoaded', function() {
        openTeamModal();
    });
    
    function openTeamModal() {
        const modal = new bootstrap.Modal(document.getElementById('teamModal'));
        modal.show();
    }
    
    function selectTeam(teamId, teamName, teamGroup) {
        currentTeam = { id: teamId, name: teamName, group: teamGroup };
        
        // Aktualisiere Banner
        document.getElementById('selectedTeamName').textContent = teamName;
        document.getElementById('selectedTeamBanner').style.display = 'flex';
        
        // Zeige Produktauswahl
        document.getElementById('productsSection').classList.add('active');
        
        // Schließe Modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('teamModal'));
        modal.hide();
    }
    
    function selectProduct(id, name, price, points) {
        // Prüfe ob Produkt bereits im Warenkorb
        const existingItem = cart.find(item => item.id === id);
        
        if (existingItem) {
            existingItem.quantity += 1;
        } else {
            cart.push({
                id: id,
                name: name,
                price: price,
                points: points,
                quantity: 1
            });
        }
        
        updateCartDisplay();
        
        // Kurze visuelle Rückmeldung
        const card = event.currentTarget;
        card.style.transform = 'scale(0.95)';
        setTimeout(() => {
            card.style.transform = '';
        }, 100);
    }
    
    function reduceQuantity(index) {
        if (cart[index].quantity > 1) {
            cart[index].quantity -= 1;
        } else {
            cart.splice(index, 1);
        }
        updateCartDisplay();
    }
    
    function removeFromCart(index) {
        cart.splice(index, 1);
        updateCartDisplay();
    }
    
    function updateCartDisplay() {
        const cartItems = document.getElementById('cartItems');
        const payButton = document.getElementById('payButton');
        
        totalPrice = 0;
        totalPoints = 0;
        
        if (cart.length === 0) {
            cartItems.innerHTML = '<p class="text-muted text-center">Noch keine Artikel</p>';
            totalPrice = 0;
            totalPoints = 0;
            payButton.disabled = true;
        } else {
            let html = '';
            
            cart.forEach((item, index) => {
                const itemTotal = item.price * item.quantity;
                totalPrice += itemTotal;
                totalPoints += item.points * item.quantity;
                
                html += `
                    <div class="cart-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1">
                                <strong>${item.quantity} x ${item.name}</strong><br>
                                <small>${item.price.toFixed(2)} € = ${itemTotal.toFixed(2)} €</small>
                                ${item.points > 0 ? `<br><small class="text-success">${item.quantity * item.points} Punkte</small>` : ''}
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-warning" onclick="reduceQuantity(${index})">−</button>
                                <button class="btn btn-sm btn-danger" onclick="removeFromCart(${index})">×</button>
                            </div>
                        </div>
                    </div>
                `;
            });
            
            cartItems.innerHTML = html;
            payButton.disabled = false;
        }
        
        document.getElementById('totalPrice').textContent = totalPrice.toFixed(2) + ' €';
        document.getElementById('totalPoints').textContent = totalPoints + ' Punkte';
    }
    
    async function completePurchase() {
        if (!currentTeam.id) {
            alert('Bitte erst ein Team auswählen!');
            openTeamModal();
            return;
        }
        
        if (cart.length === 0) {
            alert('Warenkorb ist leer!');
            return;
        }
        
        try {
            const response = await fetch('/cashier/update-beer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    teamId: currentTeam.id,
                    items: cart
                })
            });
            
            const data = await response.json();
            
            if (data.success) {
                showSuccessModal(
                    'Bestellung erfolgreich!',
                    `Gesamt: ${totalPrice.toFixed(2)} €`
                );
                
                // Warenkorb leeren
                cart = [];
                updateCartDisplay();
            } else {
                alert('Fehler beim Speichern: ' + data.message);
            }
        } catch (err) {
            console.error('Error completing purchase:', err);
            alert('Fehler beim Abschließen der Bestellung!');
        }
    }
</script>
