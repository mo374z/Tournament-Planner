<div class="container">
    <h1>Urkunden-Generator</h1>
    <form action="/certificate/generateCertificate" method="POST" target="_blank">
        <div class="form-group">
            <label for="team">Mannschaft auswählen:</label>
            <input type="text" class="form-control" id="teamSearch" placeholder="Mannschaft suchen...">
            <select class="form-control mt-2" id="team" name="teamId" required>
                {{#each teams}}
                    <option value="{{this._id}}" data-final-placement="{{this.finalPlacement}}">{{this.name}} (Platz: {{#if this.finalPlacement}}{{this.finalPlacement}}{{else}}Noch nicht platziert{{/if}})</option>
                {{/each}}
            </select>
        </div>
        <button type="submit" class="btn btn-primary mt-3" id="generateCertificateBtn">Urkunde generieren</button>
    </form>
    
    <p class="mt-4 mb-1"><strong>Alle platzierten Urkunden herunterladen:</strong></p>
    <form action="/certificate/generateAllCertificates" method="POST" class="d-inline" id="generateAllForm">
        <button type="submit" class="btn btn-success">Einzelne PDFs in ZIP</button>
    </form>
    <form action="/certificate/generateAllCertificatesPdf" method="POST" class="d-inline" id="generateAllPdfForm">
        <button type="submit" class="btn btn-success">Alle in 1 PDF</button>
    </form>
    <hr>
    <h1>Präsentations-Generator</h1>   
    <form action="/certificate/generatePresentation" method="POST">
        <button type="submit" class="btn btn-primary mt-3">PowerPoint-Präsentation generieren</button>
    <hr>
    <details class="mt-3">
        <summary class="h5" style="cursor: pointer;">Urkunde manuell erstellen</summary>
        <form action="/certificate/generateManualCertificate" method="POST" enctype="multipart/form-data" target="_blank" class="mt-3">
            <div class="row g-2">
                <div class="col-md-8">
                    <label for="manualName" class="form-label">Mannschaftsname *</label>
                    <input type="text" class="form-control" id="manualName" name="name" required>
                </div>
                <div class="col-md-2">
                    <label for="manualRank" class="form-label">Platz</label>
                    <input type="number" min="1" class="form-control" id="manualRank" name="rank">
                </div>
                <div class="col-md-2">
                    <label for="manualGroup" class="form-label">Gruppe</label>
                    <input type="text" class="form-control" id="manualGroup" name="group">
                </div>
                <div class="col-md-3">
                    <label for="manualPlayed" class="form-label">Spiele</label>
                    <input type="number" min="0" class="form-control" id="manualPlayed" name="gamesPlayed">
                </div>
                <div class="col-md-3">
                    <label for="manualWon" class="form-label">Siege</label>
                    <input type="number" min="0" class="form-control" id="manualWon" name="gamesWon">
                </div>
                <div class="col-md-3">
                    <label for="manualLost" class="form-label">Niederlagen</label>
                    <input type="number" min="0" class="form-control" id="manualLost" name="gamesLost">
                </div>
                <div class="col-md-3">
                    <label for="manualSekt" class="form-label">Sekt erhalten</label>
                    <input type="number" min="0" class="form-control" id="manualSekt" name="sektWon">
                </div>
                <div class="col-md-3">
                    <label for="manualGoalsFor" class="form-label">Tore geschossen</label>
                    <input type="number" min="0" class="form-control" id="manualGoalsFor" name="goalsFor">
                </div>
                <div class="col-md-3">
                    <label for="manualGoalsAgainst" class="form-label">Tore kassiert</label>
                    <input type="number" min="0" class="form-control" id="manualGoalsAgainst" name="goalsAgainst">
                </div>
                <div class="col-md-3">
                    <label for="manualWeizen" class="form-label">Weizen</label>
                    <input type="number" min="0" class="form-control" id="manualWeizen" name="weizen">
                </div>
                <div class="col-md-3">
                    <label for="manualPils" class="form-label">Pils</label>
                    <input type="number" min="0" class="form-control" id="manualPils" name="pils">
                </div>
                <div class="col-12">
                    <label for="manualImage" class="form-label">Foto (optional)</label>
                    <input type="file" class="form-control" id="manualImage" name="image" accept="image/png,image/jpeg,image/gif,image/webp">
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Urkunde generieren</button>
        </form>
    </details>
</div>

<!-- Status Modal -->
<div class="modal fade" id="generatingModal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="sr-only">Lädt...</span>
                </div>
                <h5>Urkunden werden generiert...</h5>
                <p class="text-muted mb-0">Bitte warten Sie, während alle Urkunden der platzierten Teams erstellt und zum Download vorbereitet werden.</p>
            </div>
        </div>
    </div>
</div>

<script>
// Function to check and update certificate button state
function updateCertificateButtonState() {
    const teamSelect = document.getElementById('team');
    const generateBtn = document.getElementById('generateCertificateBtn');
    const selectedOption = teamSelect.options[teamSelect.selectedIndex];
    
    if (selectedOption && selectedOption.dataset.finalPlacement && selectedOption.dataset.finalPlacement !== 'null' && selectedOption.dataset.finalPlacement !== '') {
        // Team has final placement - enable button
        generateBtn.disabled = false;
        generateBtn.classList.remove('btn-secondary');
        generateBtn.classList.add('btn-primary');
        generateBtn.innerHTML = 'Urkunde generieren';
    } else {
        // Team has no final placement - disable button
        generateBtn.disabled = true;
        generateBtn.classList.remove('btn-primary');
        generateBtn.classList.add('btn-secondary');
        generateBtn.innerHTML = 'Urkunde generieren (Team noch nicht platziert)';
    }
}

document.getElementById('generateAllForm').addEventListener('submit', e => handleBulkDownload(e, '/certificate/generateAllCertificates', 'zip'));
document.getElementById('generateAllPdfForm').addEventListener('submit', e => handleBulkDownload(e, '/certificate/generateAllCertificatesPdf', 'pdf'));

async function handleBulkDownload(e, endpoint, ext) {
    e.preventDefault();
    
    // Show loading modal using Bootstrap 5
    const modal = new bootstrap.Modal(document.getElementById('generatingModal'));
    modal.show();
    
    try {
        // Make AJAX request to generate certificates
        const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            }
        });
        
        if (!response.ok) {
            throw new Error('Fehler beim Generieren der Urkunden');
        }
        
        // Get the blob from response
        const blob = await response.blob();
        
        // Create download link
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Urkunden_' + new Date().toISOString().replace(/:/g, '-').split('.')[0] + '.' + ext;
        document.body.appendChild(a);
        a.click();
        
        // Cleanup
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
        
        // Close modal when done
        modal.hide();
    } catch (error) {
        console.error('Fehler:', error);
        alert('Fehler beim Generieren der Urkunden: ' + error.message);
        modal.hide();
    }
}

// Initialize button state on page load
document.addEventListener('DOMContentLoaded', function() {
    updateCertificateButtonState();
    
    // Update button state when team selection changes
    document.getElementById('team').addEventListener('change', updateCertificateButtonState);
});

document.getElementById('teamSearch').addEventListener('input', function() {
    const searchValue = this.value.toLowerCase();
    const options = document.getElementById('team').options;
    let hasResults = false;
    let resultsLength = 0;
    for (let i = 0; i < options.length; i++) {
        const optionText = options[i].text.toLowerCase();
        if (optionText.includes(searchValue)) {
            options[i].style.display = '';
            resultsLength++;
            if(resultsLength === 1) {
                options[i].selected = true;
            }
            hasResults = true;
        } else {
            options[i].style.display = 'none';
        }
    }
    document.getElementById('team').size = hasResults ? resultsLength : 1;
    
    // Update button state after search filtering
    updateCertificateButtonState();
});
</script>