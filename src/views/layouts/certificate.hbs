<div class="container">
    <h1>Urkunden-Generator</h1>
    <form action="/certificate/generateCertificate" method="POST" target="_blank">
        <div class="form-group">
            <label for="team">Mannschaft auswählen:</label>
            <input type="text" class="form-control" id="teamSearch" placeholder="Mannschaft suchen...">
            <select class="form-control mt-2" id="team" name="teamId" required>
                {{#each teams}}
                    <option value="{{this._id}}" data-final-placement="{{this.finalPlacement}}">{{this.name}} (Platz: {{#if this.finalPlacement}}{{this.finalPlacement}}{{else}}Noch nicht platziert{{/if}})</option>
                {{/each}}
            </select>
        </div>
        <button type="submit" class="btn btn-primary mt-3" id="generateCertificateBtn">Urkunde generieren</button>
    </form>
    
    <p class="mt-4 mb-1"><strong>Alle platzierten Urkunden herunterladen:</strong></p>
    <form action="/certificate/generateAllCertificates" method="POST" class="d-inline" id="generateAllForm">
        <button type="submit" class="btn btn-success">Einzelne PDFs in ZIP</button>
    </form>
    <form action="/certificate/generateAllCertificatesPdf" method="POST" class="d-inline" id="generateAllPdfForm">
        <button type="submit" class="btn btn-success">Alle in 1 PDF</button>
    </form>
    <hr>
    <h1>Präsentations-Generator</h1>
    <p class="text-muted mb-0">Die Bilder aus dem Werbe-Karussell werden automatisch auf den Sponsorenfolien verteilt.</p>
    <form action="/certificate/generatePresentation" method="POST" id="presentationForm">
        <button type="button" class="btn btn-outline-secondary mt-2" data-bs-toggle="modal" data-bs-target="#presentationOrderModal">
            Folienreihenfolge anpassen
        </button>
        <p class="text-muted mb-0 mt-2" id="presentationOrderSummary">Reihenfolge: Platz 16 bis 1</p>
        <button type="submit" class="btn btn-primary mt-3">PowerPoint-Präsentation generieren</button>
        <div class="modal fade" id="presentationOrderModal" tabindex="-1" aria-labelledby="presentationOrderTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="presentationOrderTitle">Präsentationsfolien-Reihenfolge</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
                    </div>
                    <div class="modal-body">
                        <p>Reihenfolge der Mannschaftsfolien: per Ziehen oder mit den Pfeilen ändern. Mannschaften ohne Platzierung stehen bei den Vorlagen am Ende.</p>
                        <ol class="list-group list-group-numbered" id="presentationOrder">
                            {{#each teams}}
                            <li class="list-group-item d-flex align-items-center gap-2" draggable="true" data-placement="{{this.finalPlacement}}">
                                <span class="flex-grow-1 ms-2">{{#if this.finalPlacement}}Platz {{this.finalPlacement}}{{else}}Ohne Platzierung{{/if}} – {{this.name}}</span>
                                <input type="hidden" name="teamOrder" value="{{this._id}}">
                                <button type="button" class="btn btn-sm btn-outline-secondary move-up" aria-label="{{this.name}} nach oben">↑</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary move-down" aria-label="{{this.name}} nach unten">↓</button>
                            </li>
                            {{/each}}
                        </ol>
                        {{#unless teams}}<p class="text-muted">Keine Mannschaften vorhanden.</p>{{/unless}}
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div>
                            <label for="presentationPreset" class="form-label">Vorlage auswählen</label>
                            <select class="form-select" id="presentationPreset">
                                <option value="descending">Platz 16 bis 1 (absteigend)</option>
                                <option value="special">Platz 15–4, 16, 3–1</option>
                                <option value="custom" disabled>Individuelle Reihenfolge</option>
                            </select>
                        </div>
                        <button type="button" class="btn btn-primary align-self-end" data-bs-dismiss="modal">Fertig</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <hr>
    <details class="mt-3">
        <summary class="h5" style="cursor: pointer;">Urkunde manuell erstellen</summary>
        <form action="/certificate/generateManualCertificate" method="POST" enctype="multipart/form-data" target="_blank" class="mt-3">
            <div class="row g-2">
                <div class="col-md-8">
                    <label for="manualName" class="form-label">Mannschaftsname *</label>
                    <input type="text" class="form-control" id="manualName" name="name" required>
                </div>
                <div class="col-md-2">
                    <label for="manualRank" class="form-label">Platz</label>
                    <input type="number" min="1" class="form-control" id="manualRank" name="rank">
                </div>
                <div class="col-md-2">
                    <label for="manualGroup" class="form-label">Gruppe</label>
                    <input type="text" class="form-control" id="manualGroup" name="group">
                </div>
                <div class="col-md-3">
                    <label for="manualPlayed" class="form-label">Spiele</label>
                    <input type="number" min="0" class="form-control" id="manualPlayed" name="gamesPlayed">
                </div>
                <div class="col-md-3">
                    <label for="manualWon" class="form-label">Siege</label>
                    <input type="number" min="0" class="form-control" id="manualWon" name="gamesWon">
                </div>
                <div class="col-md-3">
                    <label for="manualLost" class="form-label">Niederlagen</label>
                    <input type="number" min="0" class="form-control" id="manualLost" name="gamesLost">
                </div>
                <div class="col-md-3">
                    <label for="manualSekt" class="form-label">Sekt erhalten</label>
                    <input type="number" min="0" class="form-control" id="manualSekt" name="sektWon">
                </div>
                <div class="col-md-3">
                    <label for="manualGoalsFor" class="form-label">Tore geschossen</label>
                    <input type="number" min="0" class="form-control" id="manualGoalsFor" name="goalsFor">
                </div>
                <div class="col-md-3">
                    <label for="manualGoalsAgainst" class="form-label">Tore kassiert</label>
                    <input type="number" min="0" class="form-control" id="manualGoalsAgainst" name="goalsAgainst">
                </div>
                <div class="col-md-3">
                    <label for="manualWeizen" class="form-label">Weizen</label>
                    <input type="number" min="0" class="form-control" id="manualWeizen" name="weizen">
                </div>
                <div class="col-md-3">
                    <label for="manualPils" class="form-label">Pils</label>
                    <input type="number" min="0" class="form-control" id="manualPils" name="pils">
                </div>
                <div class="col-12">
                    <label for="manualImage" class="form-label">Foto (optional)</label>
                    <input type="file" class="form-control" id="manualImage" name="image" accept="image/png,image/jpeg,image/gif,image/webp">
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Urkunde generieren</button>
        </form>
    </details>
</div>

<!-- Status Modal -->
<div class="modal fade" id="generatingModal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="sr-only">Lädt...</span>
                </div>
                <h5>Urkunden werden generiert...</h5>
                <p class="text-muted mb-0">Bitte warten Sie, während alle Urkunden der platzierten Teams erstellt und zum Download vorbereitet werden.</p>
            </div>
        </div>
    </div>
</div>

<script>
const presentationOrder = document.getElementById('presentationOrder');
const presentationPreset = document.getElementById('presentationPreset');
const presentationOrderSummary = document.getElementById('presentationOrderSummary');

function updatePresentationOrderButtons() {
    const items = Array.from(presentationOrder.children);
    items.forEach((item, index) => {
        item.querySelector('.move-up').disabled = index === 0;
        item.querySelector('.move-down').disabled = index === items.length - 1;
    });
}

function applyPresentationPreset() {
    const items = Array.from(presentationOrder.children);
    const special = presentationPreset.value === 'special';
    const placement = item => item.dataset.placement === '' ? null : Number(item.dataset.placement);
    const section = rank => rank === null ? 3 : special && rank === 16 ? 1 : special && rank <= 3 ? 2 : 0;
    items.sort((a, b) => {
        const rankA = placement(a);
        const rankB = placement(b);
        return section(rankA) - section(rankB) || (rankB || 0) - (rankA || 0);
    });
    items.forEach(item => presentationOrder.appendChild(item));
    presentationOrderSummary.textContent = special
        ? 'Reihenfolge: Platz 15–4, 16, 3–1'
        : 'Reihenfolge: absteigend nach Platz';
    updatePresentationOrderButtons();
}

function markPresentationOrderCustom() {
    presentationPreset.value = 'custom';
    presentationOrderSummary.textContent = 'Reihenfolge: individuell';
    updatePresentationOrderButtons();
}

presentationPreset.addEventListener('change', applyPresentationPreset);
presentationOrder.addEventListener('click', event => {
    const button = event.target.closest('button');
    if (!button) return;
    const item = button.closest('li');
    if (button.classList.contains('move-up') && item.previousElementSibling) {
        presentationOrder.insertBefore(item, item.previousElementSibling);
    } else if (button.classList.contains('move-down') && item.nextElementSibling) {
        presentationOrder.insertBefore(item.nextElementSibling, item);
    } else {
        return;
    }
    markPresentationOrderCustom();
    const focusButton = item.querySelector(button.classList.contains('move-up') ? '.move-up' : '.move-down');
    if (!focusButton.disabled) focusButton.focus();
    else item.querySelector(button.classList.contains('move-up') ? '.move-down' : '.move-up').focus();
});

let draggedPresentationItem = null;
presentationOrder.addEventListener('dragstart', event => {
    draggedPresentationItem = event.target.closest('li');
    if (draggedPresentationItem) event.dataTransfer.effectAllowed = 'move';
});
presentationOrder.addEventListener('dragover', event => {
    if (draggedPresentationItem) event.preventDefault();
});
presentationOrder.addEventListener('drop', event => {
    const target = event.target.closest('li');
    if (!draggedPresentationItem || !target || target === draggedPresentationItem) return;
    event.preventDefault();
    const rect = target.getBoundingClientRect();
    presentationOrder.insertBefore(draggedPresentationItem, event.clientY < rect.top + rect.height / 2 ? target : target.nextSibling);
    markPresentationOrderCustom();
});
presentationOrder.addEventListener('dragend', () => { draggedPresentationItem = null; });
applyPresentationPreset();

// Function to check and update certificate button state
function updateCertificateButtonState() {
    const teamSelect = document.getElementById('team');
    const generateBtn = document.getElementById('generateCertificateBtn');
    const selectedOption = teamSelect.options[teamSelect.selectedIndex];
    
    if (selectedOption && selectedOption.dataset.finalPlacement && selectedOption.dataset.finalPlacement !== 'null' && selectedOption.dataset.finalPlacement !== '') {
        // Team has final placement - enable button
        generateBtn.disabled = false;
        generateBtn.classList.remove('btn-secondary');
        generateBtn.classList.add('btn-primary');
        generateBtn.innerHTML = 'Urkunde generieren';
    } else {
        // Team has no final placement - disable button
        generateBtn.disabled = true;
        generateBtn.classList.remove('btn-primary');
        generateBtn.classList.add('btn-secondary');
        generateBtn.innerHTML = 'Urkunde generieren (Team noch nicht platziert)';
    }
}

document.getElementById('generateAllForm').addEventListener('submit', e => handleBulkDownload(e, '/certificate/generateAllCertificates', 'zip'));
document.getElementById('generateAllPdfForm').addEventListener('submit', e => handleBulkDownload(e, '/certificate/generateAllCertificatesPdf', 'pdf'));

async function handleBulkDownload(e, endpoint, ext) {
    e.preventDefault();
    
    // Show loading modal using Bootstrap 5
    const modal = new bootstrap.Modal(document.getElementById('generatingModal'));
    modal.show();
    
    try {
        // Make AJAX request to generate certificates
        const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            }
        });
        
        if (!response.ok) {
            throw new Error('Fehler beim Generieren der Urkunden');
        }
        
        // Get the blob from response
        const blob = await response.blob();
        
        // Create download link
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Urkunden_' + new Date().toISOString().replace(/:/g, '-').split('.')[0] + '.' + ext;
        document.body.appendChild(a);
        a.click();
        
        // Cleanup
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
        
        // Close modal when done
        modal.hide();
    } catch (error) {
        console.error('Fehler:', error);
        alert('Fehler beim Generieren der Urkunden: ' + error.message);
        modal.hide();
    }
}

// Initialize button state on page load
document.addEventListener('DOMContentLoaded', function() {
    updateCertificateButtonState();
    
    // Update button state when team selection changes
    document.getElementById('team').addEventListener('change', updateCertificateButtonState);
});

document.getElementById('teamSearch').addEventListener('input', function() {
    const searchValue = this.value.toLowerCase();
    const options = document.getElementById('team').options;
    let hasResults = false;
    let resultsLength = 0;
    for (let i = 0; i < options.length; i++) {
        const optionText = options[i].text.toLowerCase();
        if (optionText.includes(searchValue)) {
            options[i].style.display = '';
            resultsLength++;
            if(resultsLength === 1) {
                options[i].selected = true;
            }
            hasResults = true;
        } else {
            options[i].style.display = 'none';
        }
    }
    document.getElementById('team').size = hasResults ? resultsLength : 1;
    
    // Update button state after search filtering
    updateCertificateButtonState();
});
</script>