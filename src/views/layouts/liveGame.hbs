<div class="container text-center live-wrap">
    <div class="page-divider border border-dark top-row border-2">
        {{#if mainSettings.liveGamePageOptions.showTeamLogos}}
        <!-- Layout mit Logos: Logo oben, Name unten, Score in der Mitte -->
        <div class="live-grid grid-debug">
            <!-- Team 1 Logo + Name -->
            <div class="text-center live-team" style="justify-self: end;">
                <div id="team1-logo-live" class="team-logo-live" style="margin-bottom: 10px; display: flex; justify-content: center;">
                    {{{logoDiv teamData.team1.logo teamData.team1.name 150 150}}}
                </div>
                <h3 id="team1Name" class="live-name">{{ game.opponents.[0] }}</h3>
            </div>
            
            <!-- Team 1 Score -->
            <div class="text-center live-score-box">
                <h1 id="team1Score" class="live-score">{{ game.goals.[0] }}</h1>
            </div>
            
            <!-- Timer (immer mittig) -->
            <div class="text-center live-timer-box">
                <h2><span id="liveCountdownTimer" class="live-countdown-timer"> 00:00</span></h2>
            </div>
            
            <!-- Team 2 Score -->
            <div class="text-center live-score-box">
                <h1 id="team2Score" class="live-score">{{ game.goals.[1] }}</h1>
            </div>
            
            <!-- Team 2 Logo + Name -->
            <div class="text-center live-team" style="justify-self: start;">
                <div id="team2-logo-live" class="team-logo-live" style="margin-bottom: 10px; display: flex; justify-content: center;">
                    {{{logoDiv teamData.team2.logo teamData.team2.name 150 150}}}
                </div>
                <h3 id="team2Name" class="live-name">{{ game.opponents.[1] }}</h3>
            </div>
        </div>
        {{else}}
        <!-- Layout ohne Logos: Aktuelles Layout beibehalten -->
        <div class="d-flex justify-content-between align-items-center">
            <div class="text-center d-flex align-items-center justify-content-center" style="width: 30%;">
                <div>
                    <h3 id="team1Name" class="live-name-nologo">{{ game.opponents.[0] }}</h3>
                    <h1 id="team1Score" class="live-score">{{ game.goals.[0] }}</h1>
                </div>
            </div>
            <div>
                <h2><span id="liveCountdownTimer" class="live-countdown-timer"> 00:00</span></h2>
            </div>
            <div class="text-center d-flex align-items-center justify-content-center" style="width: 30%;">
                <div>
                    <h3 id="team2Name" class="live-name-nologo">{{ game.opponents.[1] }}</h3>
                    <h1 id="team2Score" class="live-score">{{ game.goals.[1] }}</h1>
                </div>
            </div>
        </div>
        {{/if}}

        {{#if noActiveGame}}
        <p class="mt-3" id="noActiveGameMessage">Aktuell kein Spiel aktiv !</p>
        {{else}}
        <p class="mt-3 d-none" id="noActiveGameMessage">No active game</p>
        {{/if}}

        <div id="sektOverlay" class="d-none" aria-live="polite">
            <div class="sekt-fx"></div>
            <div class="sekt-bottle">
                <span class="sekt-cork">🟤</span>
                <span class="sekt-bottle-body">🍾</span>
            </div>
            <div class="sekt-banner">
                <div class="sekt-title">🥂 SEKT! 🥂</div>
                <div class="sekt-sub">für <span class="sekt-team"></span></div>
            </div>
        </div>

        {{!-- Timer Status (ausgeblendet): --}}
        <span id="timerStatus" class="ml-2 d-none"></span> 
    </div>

    <div id="connectionIndicator" class="text-center mt-3">
        <span id="connectionStatusText" class="text-danger">Verbinde...</span>
    </div>
</div>

<!-- Carousel Section - gleiche Breite wie Spielstandsanzeige -->
<div class="container text-center live-wrap">
    <div id="carouselSlidesOnly" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner d-flex align-items-center page-divider live-carousel" id="carouselImages">
            {{#each carouselImages}}
                <div class="carousel-item {{#if @first}}active{{/if}}" data-bs-interval="5000">
                    <img class="d-block w-100 h-100 object-fit-contain carousel-image" src="/images/carousel/{{this}}" alt="{{this}}">
                </div>
            {{/each}}
        </div>
        <!-- Navigation buttons -->
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselSlidesOnly" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselSlidesOnly" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

    <style>
        .live-wrap { width: 1200px; max-width: 95vw; margin: 0 auto; }
        .live-carousel { height: clamp(160px, 30vw, 400px); overflow: hidden; }
        .live-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto auto auto minmax(0, 1fr);
            align-items: center;
            justify-items: center;
            height: clamp(130px, 18vw, 220px);
            gap: clamp(4px, 1.2vw, 15px);
        }
        .live-team { min-width: 0; width: 100%; }
        .live-team .team-logo-live > * {
            width: clamp(60px, 12.5vw, 150px) !important;
            height: clamp(60px, 12.5vw, 150px) !important;
            max-width: 100%;
        }
        .live-name {
            font-size: clamp(12pt, 2.7vw, 32pt);
            margin-bottom: 0;
            white-space: nowrap;
            line-height: 1.15;
            width: max-content;
            position: relative;
            left: 50%;
            translate: -50% 0;
        }
        .live-name-nologo {
            font-size: clamp(14pt, 3vw, 35pt);
            white-space: nowrap;
            line-height: 1.15;
            width: max-content;
            position: relative;
            left: 50%;
            translate: -50% 0;
        }
        .live-score { font-weight: bold; font-size: clamp(32pt, 7.5vw, 90pt); margin: 0; }
        .live-score-box { min-width: clamp(60px, 16vw, 200px); }
        .live-timer-box { min-width: clamp(90px, 18vw, 220px); }

        @media (max-width: 576px) {
            .live-grid { grid-template-columns: 1fr 1fr 1fr; height: auto; padding: 8px 0; }
            .live-grid .live-team:first-child { grid-column: 1 / 2; grid-row: 1; justify-self: center !important; }
            .live-grid .live-team:last-child { grid-column: 3 / 4; grid-row: 1; justify-self: center !important; }
            .live-grid .live-timer-box { grid-column: 2 / 3; grid-row: 1; min-width: 0; }
            .live-grid .live-score-box:nth-child(2) { grid-column: 1 / 2; grid-row: 2; min-width: 0; }
            .live-grid .live-score-box:nth-child(4) { grid-column: 3 / 4; grid-row: 2; min-width: 0; }
            .live-countdown-timer { font-size: 28pt !important; }
            .sekt-title { font-size: 40px !important; }
            .sekt-sub { font-size: 24px !important; }
            .sekt-bottle { font-size: 60px !important; }
        }

        .carousel-image {
            object-fit: contain;
            width: 100%;
            height: 98%;
        }

        .carousel-item {
            width: 100%;
            height: 100%;
            object-fit: contain
        }

        .top-row { position: relative; overflow: hidden; }
        #sektOverlay {
            position: absolute;
            inset: 0;
            z-index: 2000;
            pointer-events: none;
            overflow: hidden;
            background: radial-gradient(circle at 50% 70%, rgba(0,0,0,0.55), rgba(0,0,0,0.8));
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #sektOverlay.d-none { display: none !important; }
        #sektOverlay.sekt-show { animation: sektOverlayFade 10s ease-in-out forwards; }

        .sekt-bottle {
            position: absolute;
            left: 50%;
            bottom: 4%;
            font-size: 90px;
            line-height: 1;
            transform-origin: 50% 100%;
        }
        .sekt-show .sekt-bottle { animation: sektBottle 10s ease-in-out forwards; }
        .sekt-bottle-body { display: inline-block; }
        .sekt-cork {
            position: absolute;
            left: 50%;
            top: 0;
            font-size: 24px;
            opacity: 0;
        }
        .sekt-show .sekt-cork { animation: sektCork 1.6s ease-out 1.3s forwards; }

        .sekt-fx {
            position: absolute;
            left: 50%;
            bottom: 30%;
            width: 0;
            height: 0;
        }
        .sekt-confetti, .sekt-foam {
            position: absolute;
            opacity: 0;
            animation: sektBurst 2.6s cubic-bezier(.1,.7,.3,1) forwards;
        }
        .sekt-confetti { width: 9px; height: 14px; border-radius: 2px; }
        .sekt-foam {
            width: 12px; height: 12px; border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #fff, #fff6c9 70%);
            box-shadow: 0 0 10px rgba(255,255,255,0.8);
        }

        .sekt-banner {
            position: relative;
            text-align: center;
            color: #fff;
            text-shadow: 0 0 10px rgba(255,255,255,0.5);
            opacity: 0;
        }
        .sekt-show .sekt-banner { animation: sektBanner 10s ease-out forwards; }
        .sekt-title {
            font-size: 80px;
            line-height: 1.1;
            font-weight: 900;
            letter-spacing: 4px;
            background: linear-gradient(90deg, #ffd54a, #fff0b3, #ffd54a, #ffbf24);
            background-size: 200% auto;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: none;
            filter: drop-shadow(0 0 8px rgba(255,255,255,0.6));
            animation: sektShine 2s linear infinite;
        }
        .sekt-sub { font-size: 48px; font-weight: 700; color: #f2f2f2; }
        .sekt-team { color: #ffd54a; }

        @keyframes sektOverlayFade {
            0% { opacity: 0; } 5% { opacity: 1; } 92% { opacity: 1; } 100% { opacity: 0; }
        }
        @keyframes sektBottle {
            0% { transform: translateX(-50%) translateY(160px) rotate(0); opacity: 0; }
            6% { transform: translateX(-50%) translateY(0) rotate(0); opacity: 1; }
            7% { transform: translateX(-50%) rotate(-6deg); }
            8.5% { transform: translateX(-50%) rotate(6deg); }
            10% { transform: translateX(-50%) rotate(-8deg); }
            11.5% { transform: translateX(-50%) rotate(8deg); }
            13% { transform: translateX(-50%) rotate(-25deg) scale(1.1); }
            17%, 23% { transform: translateX(-50%) rotate(-25deg); opacity: 1; }
            27%, 100% { transform: translateX(-50%) rotate(-25deg); opacity: 0; }
        }
        @keyframes sektCork {
            0% { opacity: 1; transform: translate(0, 0) rotate(0); }
            100% { opacity: 0; transform: translate(140px, -200px) rotate(900deg); }
        }
        @keyframes sektBurst {
            0% { opacity: 1; transform: translate(0, 0) rotate(0) scale(1); }
            70% { opacity: 1; }
            100% { opacity: 0; transform: translate(var(--dx), calc(var(--dy) + 120px)) rotate(var(--rot)) scale(0.6); }
        }
        @keyframes sektBanner {
            0%, 13% { opacity: 0; transform: translateY(100px) scale(0.05) rotate(-15deg); }
            16% { opacity: 1; }
            23% { opacity: 1; transform: translateY(0) scale(1.2) rotate(3deg); }
            27%, 88% { opacity: 1; transform: translateY(0) scale(1) rotate(0); }
            100% { opacity: 0; transform: translateY(0) scale(1); }
        }
        @keyframes sektShine { to { background-position: 200% center; } }
        
        /* Live Countdown Timer Styles */
        .live-countdown-timer {
            font-weight: bold;
            font-size: clamp(30pt, 7.5vw, 90pt);
            color: #757575;
            transition: color 0.3s ease;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
        }
        
        .live-countdown-timer.last-minute {
            color: #dc3545 !important;
        }

        .live-countdown-timer.overtime {
            color: #f2b705 !important;
        }
        
        {{!-- /* Grid Debug Styles - für Testzwecke */
        .grid-debug {
            border: 2px solid red !important;
            background-color: rgba(255, 0, 0, 0.1) !important;
        }
        
        .grid-debug > div {
            border: 1px solid blue !important;
            background-color: rgba(0, 0, 255, 0.05) !important;
        } --}}

        @keyframes fadeInOut {
            0%, 100% { opacity: 0; }
            5%, 95% { opacity: 1; }
        }

        @keyframes borderBlink {
            0% { border-color: red; }
            25% { border-color: yellow; }
            50% { border-color: green; }
            75% { border-color: blue; }
            100% { border-color: red; }
        }
    </style>

<script src="https://cdn.socket.io/4.3.1/socket.io.min.js"></script>
<script>
    const socket = io('{{socketConfig.protocol}}://{{socketConfig.host}}:{{socketConfig.socketPort}}');

    socket.on('connect', () => {
        console.log('Socket connected');
        document.getElementById('connectionStatusText').classList.remove('text-danger');
        document.getElementById('connectionStatusText').classList.add('text-success');
        document.getElementById('connectionStatusText').textContent = 'Verbunden';
    });

    socket.on('disconnect', () => {
        console.log('Socket disconnected');
        document.getElementById('connectionStatusText').classList.remove('text-success');
        document.getElementById('connectionStatusText').classList.add('text-danger');
        document.getElementById('connectionStatusText').textContent = 'Getrennt';
    });

    socket.on('timerUpdate', (timerValue, isPaused, timerStatus, lastMin) => {
        const minutes = Math.floor(timerValue / 60);
        const seconds = timerValue % 60;
        const formattedTime = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        const isOvertime = timerStatus === 'Overtime';
        const liveCountdownTimer = document.getElementById('liveCountdownTimer');
        liveCountdownTimer.innerText = (isOvertime ? '+' : '') + formattedTime;
        document.getElementById('timerStatus').innerText = `Status: ${timerStatus}`;
        liveCountdownTimer.classList.toggle('overtime', isOvertime);
        if (lastMin && !isOvertime) {
            liveCountdownTimer.classList.add('last-minute');
        } else {
            liveCountdownTimer.classList.remove('last-minute');
        }
    });

    socket.on('updateLiveGame', (updatedGame) => {
        updatePage(updatedGame);
        console.log('Game updated');
    });

    const soundFiles = { start: 'startsound', pause: 'pausesound', resume: 'resumesound', end: 'endsound' };

    function playSoundFor(type) {
        const name = soundFiles[type] || soundFiles.end;
        const audio = new Audio('/sounds/' + name + '.mp3?t=' + Date.now());
        audio.play().catch(() => {
            // No custom sound uploaded -> fall back to default horn
            new Audio('/sounds/Horn.mp3').play().catch(() => {});
        });
    }

    socket.on('playSound', (type) => {
        playSoundFor(type);
        const pageDivider = document.querySelector('.top-row');
        console.log('playSound');   
        pageDivider.classList.add('border-success');
        pageDivider.classList.remove('border-dark');
        setTimeout(() => {
            pageDivider.classList.remove('border-success');
            pageDivider.classList.add('border-dark');
        }, 2000); // Rahmen für 2 Sekunden grün aufleuchten lassen
    });

    let gameOppNames = ['{{ game.opponents.[0] }}', '{{ game.opponents.[1] }}'];
    let lastgameStatus = '{{ game.status }}';
    const logoDisplaySetting = {{#if mainSettings.liveGamePageOptions.showTeamLogos}} true {{else}} false {{/if}};

    async function updatePage(game) {

        //Wenn davor kein aktives spiel bzw lastgame
        if (lastgameStatus !== 'active') {
            location.reload();
            return;
        }
        console.log('last gameStatus: ' + lastgameStatus + ' -> ' + game.status);
        lastgameStatus = game.status;
        updateScore('team1Score', game.goals[0]);
        updateScore('team2Score', game.goals[1]);  
        const teamName1 = await updateName('team1Name', game.opponents[0]);
        const teamName2 = await updateName('team2Name', game.opponents[1]); 

        // Update logos if logos are available
        if (game != null && logoDisplaySetting === true) {
            console.log('Logos aktiv');
            if(gameOppNames[0] !== '' || gameOppNames[1] !== '') {
                await updateLogo('team1', game.opponents[0]);
                await updateLogo('team2', game.opponents[1]);
                console.log('Logos updated');
            }

        }

        gameOppNames = [teamName1, teamName2];
        console.log('gameOppNames: ' + gameOppNames);

        SetActiveGameMessage(game.status);
    }

    function SetActiveGameMessage(status) {        
        if (status === 'active') {
            NoActiveGameMessage = document.getElementById('noActiveGameMessage');
            NoActiveGameMessage.style.display = 'none';
        } else {
            NoActiveGameMessage = document.getElementById('noActiveGameMessage');
            NoActiveGameMessage.style.display = 'block';
        }        
    }

    function updateScore(elementId, score) {
        const scoreElement = document.getElementById(elementId);
        if (scoreElement) {
            scoreElement.innerText = score;
        }
    }

    // Schriftgröße bleibt gleich; ragt der Name über den Rand, wird er Richtung Mitte verschoben
    function fitName(el) {
        if (!el) return;
        el.style.transform = '';
        const range = document.createRange();
        range.selectNodeContents(el);
        const text = range.getBoundingClientRect();
        const bounds = (el.closest('.live-grid') || document.body).getBoundingClientRect();
        const margin = 4;
        const left = Math.max(bounds.left, 0) + margin;
        const right = Math.min(bounds.right, window.innerWidth) - margin;
        let dx = 0;
        if (text.left < left) {
            dx = left - text.left;
        } else if (text.right > right) {
            dx = right - text.right;
        }
        if (dx) el.style.transform = `translateX(${dx}px)`;
    }
    function fitAllNames() {
        document.querySelectorAll('.live-name, .live-name-nologo').forEach(fitName);
    }
    window.addEventListener('resize', fitAllNames);
    document.addEventListener('DOMContentLoaded', fitAllNames);

    async function updateName(elementId, teamID) {
        // get name based on id
        const response = await fetch(`/team/getTeamName/${teamID}`, { method: 'GET'})

        if (response.ok) {
            // get the team name which is returned as a string
            const teamName = await response.text();
            const nameElement = document.getElementById(elementId);
            if (nameElement) {
                nameElement.innerText = teamName;
                fitName(nameElement);
            }
            return teamName;
        } else {
            console.error('Failed to get team name');
            return "Error fetching team name";
        }
    }

    async function updateLogo(teamPrefix, teamID) { // Lade die neuen Logos beim Starten eines neuen Spiels
        try {
            const response = await fetch(`/team/getTeamLogo/${teamID}`, { method: 'GET'});
            
            if (response.ok) {
                const logoData = await response.json();
                const logoContainer = document.getElementById(`${teamPrefix}-logo-live`);
                
                if (logoContainer) {
                    if (logoData.logo && logoData.logo.path) {
                        // Verwende normalisierte Werte für konsistente Positionierung
                        const normalizedX = logoData.logo.position?.x ?? 0.5;
                        const normalizedY = logoData.logo.position?.y ?? 0.5;
                        const baseScale = logoData.logo.scale || 0.5;
                        const backgroundColor = logoData.logo.backgroundColor || '#f8f9fa';
                        
                        // Berechne angepasste Skalierung für 150x150 Container
                        const containerSize = 150;
                        const scaleFactor = containerSize / 150;
                        const adjustedScale = Math.max(0.1, Math.min(2, baseScale * scaleFactor));
                        
                        // Berechne Prozent-Position aus normalisierten Werten
                        const leftPercent = (normalizedX * 100).toFixed(1) + '%';
                        const topPercent = (normalizedY * 100).toFixed(1) + '%';
                        
                        // Temporär das Flexbox-Styling entfernen, um Positionierungskonflikt zu vermeiden
                        const originalDisplay = logoContainer.style.display;
                        const originalJustifyContent = logoContainer.style.justifyContent;
                        logoContainer.style.display = 'block';
                        logoContainer.style.justifyContent = 'unset';
                        
                        // Erzeuge neuen Logo-HTML mit dem gleichen Format wie logoDiv Helper
                        logoContainer.innerHTML = `
                            <div style="width: 150px; height: 150px; position: relative; 
                                        background: ${backgroundColor}; border-radius: 50%; border: none; overflow: hidden; margin: 0 auto;">
                                <img src="${logoData.logo.path}" alt="Team Logo" 
                                     style="position: absolute;
                                            left: ${leftPercent};
                                            top: ${topPercent};
                                            transform: translate(-50%, -50%) scale(${adjustedScale});
                                            max-width: none;
                                            pointer-events: none;">
                            </div>
                        `;
                        
                        console.log(`Updated logo for ${teamPrefix} using normalized positioning: (${normalizedX}, ${normalizedY})`);
                    } else {
                        // Hide logo container if no logo - zeige Fallback
                        logoContainer.style.display = 'block';
                        logoContainer.style.justifyContent = 'unset';
                        logoContainer.innerHTML = `
                            <div style="width: 150px; height: 150px; background: #f8f9fa; border: 1px solid #ddd; border-radius: 50%; 
                                        display: flex; align-items: center; justify-content: center; overflow: hidden; margin: 0 auto;">
                                <small class="text-muted">Logo</small>
                            </div>
                        `;
                        console.log(`No logo found for ${teamPrefix}, showing fallback`);
                    }
                } else {
                    console.log(`No logo container found for ${teamPrefix}`);
                }
            }
        } catch (error) {
            console.error('Failed to update logo:', error);
        }
    }

    let sektTimeout = null;
    socket.on('Sekt', (team) => {
        console.log('Sekt for Team: ' + team.name);
        const overlay = document.getElementById('sektOverlay');
        const fx = overlay.querySelector('.sekt-fx');
        overlay.querySelector('.sekt-team').textContent = team.name;
        fx.innerHTML = '';

        const colors = ['#ffd700', '#ff4d6d', '#4dabf7', '#51cf66', '#fff', '#ff922b', '#cc5de8'];
        // Konfetti + Schaum-Spritzer
        for (let i = 0; i < 90; i++) {
            const p = document.createElement('span');
            const isFoam = i % 3 === 0;
            p.className = isFoam ? 'sekt-foam' : 'sekt-confetti';
            const angle = (-90 + (Math.random() - 0.5) * 140) * Math.PI / 180;
            const dist = 90 + Math.random() * 280;
            p.style.setProperty('--dx', Math.cos(angle) * dist + 'px');
            p.style.setProperty('--dy', Math.sin(angle) * dist + 'px');
            p.style.setProperty('--rot', (Math.random() * 1080 - 540) + 'deg');
            p.style.animationDelay = (1.3 + Math.random() * 0.25) + 's';
            if (!isFoam) p.style.background = colors[i % colors.length];
            fx.appendChild(p);
        }

        // Animation neu starten
        overlay.classList.remove('d-none', 'sekt-show');
        void overlay.offsetWidth;
        overlay.classList.add('sekt-show');

        clearTimeout(sektTimeout);
        sektTimeout = setTimeout(() => {
            overlay.classList.add('d-none');
            overlay.classList.remove('sekt-show');
        }, 10000);
    });

    socket.emit('getData'); //Call for game data when page loads
</script>