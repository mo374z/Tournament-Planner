<script>
// Global variables for modal
let currentImageSrc = '';
let currentTeamName = '';
let currentLogoSrc = '';
let currentLogoTeamName = '';
let currentLogoTeamId = '';
let logoPositionData = {};

// Show image in modal
function showImageModal(imageSrc, teamName, teamId) {
    currentImageSrc = imageSrc;
    currentTeamName = teamName;
    
    const modalImage = document.getElementById('modalTeamImage');
    const modalTitle = document.getElementById('modalTeamName');
    const modalTeamId = document.getElementById('modalTeamId');
    
    modalImage.src = imageSrc;
    modalImage.alt = teamName + ' - Teambild';
    modalTitle.textContent = teamName + ' - Teambild';
    
    // Set team ID for upload form
    if (modalTeamId && teamId) {
        modalTeamId.value = teamId;
    }
}

// Show logo modal
function showLogoModal(logoSrc, teamName, teamId) {
    currentLogoSrc = logoSrc;
    currentLogoTeamName = teamName;
    currentLogoTeamId = teamId;
    
    document.getElementById('logoTeamId').value = teamId;
    
    // Update modal title
    document.getElementById('teamLogoModalLabel').innerHTML = 
        `<i class="fas fa-shield-alt me-2"></i>Team Logo: ${teamName}`;
    
    // Set logo image src
    const logoImg = document.getElementById('myteam-logo-img');
    if (logoImg && currentLogoSrc) {
        logoImg.src = currentLogoSrc;
        logoImg.style.display = 'block';
    }
    
    // Load logo data and display
    loadLogoData(teamId);
}

// Load logo data from backend
function loadLogoData(teamId) {
    fetch(`/team/${teamId}/logoData`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.logo) {
                logoPositionData = data.logo;
                updateMyTeamLogoFromData();
            } else {
                // Use default values if no logo data found
                logoPositionData = {
                    position: { x: 0.5, y: 0.5 },
                    scale: 0.5,
                    backgroundColor: '#f8f9fa'
                };
                updateMyTeamLogoFromData();
            }
        })
        .catch(error => {
            console.error('Error loading logo data:', error);
            // Fallback with default values
            logoPositionData = {
                position: { x: 0.5, y: 0.5 },
                scale: 0.5,
                backgroundColor: '#f8f9fa'
            };
            updateMyTeamLogoFromData();
        });
}

// Update MyTeam logo display with loaded data
function updateMyTeamLogoFromData() {
    const logoImg = document.getElementById('myteam-logo-img');
    const logoContainer = document.getElementById('myteam-logo-container');
    const scaleSlider = document.getElementById('myteam-logo-scale');
    const scaleValue = document.getElementById('myteam-scale-value');
    const backgroundColorPicker = document.getElementById('myteam-background-color');
    
    if (!logoImg || !logoContainer) {
        console.log('Logo elements not found');
        return;
    }
    
    console.log('Updating MyTeam logo from data:', logoPositionData);
    
    const position = logoPositionData.position || { x: 0.5, y: 0.5 };
    const scale = logoPositionData.scale || 0.5;
    const backgroundColor = logoPositionData.backgroundColor || '#f8f9fa';
    
    // Update controls
    if (scaleSlider) scaleSlider.value = scale;
    if (scaleValue) scaleValue.textContent = scale;
    if (backgroundColorPicker) backgroundColorPicker.value = backgroundColor;
    
    // Update container background
    logoContainer.style.backgroundColor = backgroundColor;
    
    // Store normalized values
    logoImg.dataset.normalizedX = position.x;
    logoImg.dataset.normalizedY = position.y;
    
    console.log('Set normalized values:', position.x, position.y, 'scale:', scale);
    
    // Direct CSS positioning like in team details
    updateMyTeamLogoPosition(logoImg, position.x, position.y, scale);
}

// Direct logo positioning function
function updateMyTeamLogoPosition(logoImg, normalizedX, normalizedY, scale) {
    if (!logoImg) return;
    
    // Convert normalized values to percentage
    const leftPercent = normalizedX * 100;
    const topPercent = normalizedY * 100;
    
    // Apply CSS transforms directly like in team details
    logoImg.style.position = 'absolute';
    logoImg.style.transformOrigin = 'center center';
    logoImg.style.transform = `translate(-50%, -50%) scale(${scale})`;
    logoImg.style.left = `${leftPercent}%`;
    logoImg.style.top = `${topPercent}%`;
    logoImg.style.maxWidth = 'none';
    logoImg.style.cursor = 'move';
    
    console.log(`Applied CSS: left: ${leftPercent}%, top: ${topPercent}%, scale: ${scale}`);
}

// Download image function
function downloadImage() {
    if (!currentImageSrc) return;
    
    const link = document.createElement('a');
    link.href = currentImageSrc;
    
    // Get filename from path or create one
    const filename = currentImageSrc.split('/').pop() || `${currentTeamName.replace(/\s+/g, '_')}_teambild.jpg`;
    link.download = filename;
    
    // Trigger download
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

// Add hover effect for clickable image
document.addEventListener('DOMContentLoaded', function() {
    const clickableImages = document.querySelectorAll('.team-image-clickable');
    clickableImages.forEach(function(img) {
        img.addEventListener('mouseenter', function() {
            this.style.transform = 'scale(1.05)';
            this.style.transition = 'transform 0.3s ease';
        });
        
        img.addEventListener('mouseleave', function() {
            this.style.transform = 'scale(1)';
        });
    });
    
    // MyTeam Logo Modal Event Listeners
    initMyTeamLogoEventListeners();
    
    // MyTeam Add Player Modal Event Listeners
    {{#if mainSettings.myTeamPageOptions.allowPlayerAdd}}
    initAddPlayerModal();
    {{/if}}
});

// Initialize MyTeam Logo Event Listeners
function initMyTeamLogoEventListeners() {
    {{#if mainSettings.myTeamPageOptions.allowLogoUpload}}
    // Wait for modal to be visible before initializing
    const logoModal = document.getElementById('teamLogoModal');
    if (logoModal) {
        logoModal.addEventListener('shown.bs.modal', function() {
            setupMyTeamLogoControls();
        });
    }
    {{/if}}
}

// Setup MyTeam Logo Controls (called when modal is shown)
function setupMyTeamLogoControls() {
    const logoImg = document.getElementById('myteam-logo-img');
    const logoContainer = document.getElementById('myteam-logo-container');
    const scaleSlider = document.getElementById('myteam-logo-scale');
    const scaleValue = document.getElementById('myteam-scale-value');
    const backgroundColorPicker = document.getElementById('myteam-background-color');
    
    if (!logoImg || !logoContainer) return;
    
    console.log('Setting up MyTeam logo controls...');
    
    let isDragging = false;
    
    // Remove existing event listeners to prevent duplicates
    logoImg.removeEventListener('mousedown', handleMouseDown);
    document.removeEventListener('mousemove', handleMouseMove);
    document.removeEventListener('mouseup', handleMouseUp);
    
    // Mouse event handlers
    function handleMouseDown(e) {
        isDragging = true;
        e.preventDefault();
        console.log('Started dragging');
    }
    
    function handleMouseMove(e) {
        if (isDragging) {
            const rect = logoContainer.getBoundingClientRect();
            const centerX = e.clientX - rect.left;
            const centerY = e.clientY - rect.top;
            
            // Convert to normalized values (0-1)
            const normalizedX = Math.max(0, Math.min(1, centerX / rect.width));
            const normalizedY = Math.max(0, Math.min(1, centerY / rect.height));
            
            // Update position with direct CSS
            const currentScale = parseFloat(scaleSlider ? scaleSlider.value : 0.5) || 0.5;
            updateMyTeamLogoPosition(logoImg, normalizedX, normalizedY, currentScale);
            
            // Store normalized values in data attributes
            logoImg.dataset.normalizedX = normalizedX;
            logoImg.dataset.normalizedY = normalizedY;
            
            console.log('Updated position:', normalizedX, normalizedY);
        }
    }
    
    function handleMouseUp() {
        if (isDragging) {
            console.log('Stopped dragging');
        }
        isDragging = false;
    }
    
    // Add event listeners
    logoImg.addEventListener('mousedown', handleMouseDown);
    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
    
    // Scale functionality
    if (scaleSlider) {
        scaleSlider.removeEventListener('input', scaleSlider.myTeamScaleHandler);
        
        scaleSlider.myTeamScaleHandler = function() {
            const scale = this.value;
            const normalizedX = parseFloat(logoImg.dataset.normalizedX) || 0.5;
            const normalizedY = parseFloat(logoImg.dataset.normalizedY) || 0.5;
            
            updateMyTeamLogoPosition(logoImg, normalizedX, normalizedY, scale);
            if (scaleValue) scaleValue.textContent = scale;
            
            console.log('Scale changed to:', scale);
        };
        
        scaleSlider.addEventListener('input', scaleSlider.myTeamScaleHandler);
    }
    
    // Background color functionality
    if (backgroundColorPicker) {
        backgroundColorPicker.removeEventListener('input', backgroundColorPicker.myTeamBgHandler);
        
        backgroundColorPicker.myTeamBgHandler = function() {
            logoContainer.style.backgroundColor = this.value;
            console.log('Background color changed to:', this.value);
        };
        
        backgroundColorPicker.addEventListener('input', backgroundColorPicker.myTeamBgHandler);
    }
    
    // Arrow movement functions
    function moveLogoByArrow(direction) {
        let normalizedX = parseFloat(logoImg.dataset.normalizedX) || 0.5;
        let normalizedY = parseFloat(logoImg.dataset.normalizedY) || 0.5;
        let step = 0.02; // 2% in normalized values
        
        switch(direction) {
            case 'up':
                normalizedY = Math.max(0, normalizedY - step);
                break;
            case 'down':
                normalizedY = Math.min(1, normalizedY + step);
                break;
            case 'left':
                normalizedX = Math.max(0, normalizedX - step);
                break;
            case 'right':
                normalizedX = Math.min(1, normalizedX + step);
                break;
        }
        
        const currentScale = parseFloat(scaleSlider ? scaleSlider.value : 0.5) || 0.5;
        updateMyTeamLogoPosition(logoImg, normalizedX, normalizedY, currentScale);
        logoImg.dataset.normalizedX = normalizedX;
        logoImg.dataset.normalizedY = normalizedY;
        
        console.log('Arrow moved to:', direction, normalizedX, normalizedY);
    }
    
    // Arrow button event listeners
    const upBtn = document.getElementById('myteam-move-up');
    const downBtn = document.getElementById('myteam-move-down');
    const leftBtn = document.getElementById('myteam-move-left');
    const rightBtn = document.getElementById('myteam-move-right');
    
    if (upBtn) {
        upBtn.removeEventListener('click', upBtn.myTeamMoveHandler);
        upBtn.myTeamMoveHandler = () => moveLogoByArrow('up');
        upBtn.addEventListener('click', upBtn.myTeamMoveHandler);
    }
    
    if (downBtn) {
        downBtn.removeEventListener('click', downBtn.myTeamMoveHandler);
        downBtn.myTeamMoveHandler = () => moveLogoByArrow('down');
        downBtn.addEventListener('click', downBtn.myTeamMoveHandler);
    }
    
    if (leftBtn) {
        leftBtn.removeEventListener('click', leftBtn.myTeamMoveHandler);
        leftBtn.myTeamMoveHandler = () => moveLogoByArrow('left');
        leftBtn.addEventListener('click', leftBtn.myTeamMoveHandler);
    }
    
    if (rightBtn) {
        rightBtn.removeEventListener('click', rightBtn.myTeamMoveHandler);
        rightBtn.myTeamMoveHandler = () => moveLogoByArrow('right');
        rightBtn.addEventListener('click', rightBtn.myTeamMoveHandler);
    }
    
    // Center horizontally
    const centerHorizontalBtn = document.getElementById('myteam-center-horizontal');
    if (centerHorizontalBtn) {
        centerHorizontalBtn.removeEventListener('click', centerHorizontalBtn.myTeamCenterHHandler);
        
        centerHorizontalBtn.myTeamCenterHHandler = function() {
            const normalizedY = parseFloat(logoImg.dataset.normalizedY) || 0.5;
            const currentScale = parseFloat(scaleSlider ? scaleSlider.value : 0.5) || 0.5;
            updateMyTeamLogoPosition(logoImg, 0.5, normalizedY, currentScale);
            logoImg.dataset.normalizedX = 0.5;
            console.log('Centered horizontally');
        };
        
        centerHorizontalBtn.addEventListener('click', centerHorizontalBtn.myTeamCenterHHandler);
    }
    
    // Center vertically
    const centerVerticalBtn = document.getElementById('myteam-center-vertical');
    if (centerVerticalBtn) {
        centerVerticalBtn.removeEventListener('click', centerVerticalBtn.myTeamCenterVHandler);
        
        centerVerticalBtn.myTeamCenterVHandler = function() {
            const normalizedX = parseFloat(logoImg.dataset.normalizedX) || 0.5;
            const currentScale = parseFloat(scaleSlider ? scaleSlider.value : 0.5) || 0.5;
            updateMyTeamLogoPosition(logoImg, normalizedX, 0.5, currentScale);
            logoImg.dataset.normalizedY = 0.5;
            console.log('Centered vertically');
        };
        
        centerVerticalBtn.addEventListener('click', centerVerticalBtn.myTeamCenterVHandler);
    }
    
    // Reset functionality
    const resetBtn = document.getElementById('myteam-reset-logo');
    if (resetBtn) {
        resetBtn.removeEventListener('click', resetBtn.myTeamResetHandler);
        
        resetBtn.myTeamResetHandler = function() {
            const normalizedX = 0.5;
            const normalizedY = 0.5;
            const defaultScale = 0.5;
            const defaultBackgroundColor = '#f8f9fa';
            
            updateMyTeamLogoPosition(logoImg, normalizedX, normalizedY, defaultScale);
            logoImg.dataset.normalizedX = normalizedX;
            logoImg.dataset.normalizedY = normalizedY;
            
            if (scaleSlider) scaleSlider.value = defaultScale;
            if (scaleValue) scaleValue.textContent = defaultScale;
            if (backgroundColorPicker) backgroundColorPicker.value = defaultBackgroundColor;
            logoContainer.style.backgroundColor = defaultBackgroundColor;
            
            console.log('Reset logo position');
        };
        
        resetBtn.addEventListener('click', resetBtn.myTeamResetHandler);
    }
    
    // Save functionality
    const saveBtn = document.getElementById('myteam-save-logo-position');
    if (saveBtn) {
        saveBtn.removeEventListener('click', saveBtn.myTeamSaveHandler);
        
        saveBtn.myTeamSaveHandler = function() {
            const normalizedX = parseFloat(logoImg.dataset.normalizedX) || 0.5;
            const normalizedY = parseFloat(logoImg.dataset.normalizedY) || 0.5;
            const currentScale = parseFloat(scaleSlider ? scaleSlider.value : 0.5) || 0.5;
            const currentBackgroundColor = backgroundColorPicker ? backgroundColorPicker.value : '#f8f9fa';
            
            console.log('Saving normalized position:', normalizedX, normalizedY, 'scale:', currentScale);
            
            fetch('/myteam/saveLogoPosition', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    x: normalizedX,
                    y: normalizedY,
                    scale: currentScale,
                    backgroundColor: currentBackgroundColor
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Logo-Position erfolgreich gespeichert!');
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                } else {
                    alert('Fehler beim Speichern: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error saving logo position:', error);
                alert('Fehler beim Speichern der Logo-Position!');
            });
        };
        
        saveBtn.addEventListener('click', saveBtn.myTeamSaveHandler);
    }
    
    console.log('MyTeam logo controls setup complete');
}

// Initialize Add Player Modal functionality
function initAddPlayerModal() {
    const addPlayerModal = document.getElementById('addPlayerModal');
    const addPlayerForm = document.getElementById('addPlayerForm');
    const savePlayerBtn = document.getElementById('savePlayerBtn');
    const playerNameInput = document.getElementById('playerName');
    const playerNumberInput = document.getElementById('playerNumber');
    const addPlayerInfo = document.getElementById('addPlayerInfo');
    const addPlayerError = document.getElementById('addPlayerError');
    const addPlayerInfoText = document.getElementById('addPlayerInfoText');
    const addPlayerErrorText = document.getElementById('addPlayerErrorText');
    
    if (!addPlayerModal || !addPlayerForm || !savePlayerBtn) return;
    
    // Reset modal when opened
    addPlayerModal.addEventListener('show.bs.modal', function() {
        addPlayerForm.reset();
        hideMessages();
    });
    
    // Save player button click
    savePlayerBtn.addEventListener('click', async function() {
        const name = playerNameInput.value.trim();
        const number = playerNumberInput.value.trim();
        
        // Validation
        if (!name) {
            showError('Name ist erforderlich.');
            playerNameInput.focus();
            return;
        }
        
        if (name.length > 50) {
            showError('Name darf maximal 50 Zeichen lang sein.');
            playerNameInput.focus();
            return;
        }
        
        if (number && number.length > 3) {
            showError('Trikotnummer darf maximal 3 Zeichen lang sein.');
            playerNumberInput.focus();
            return;
        }
        
        // Show loading state
        savePlayerBtn.disabled = true;
        const originalText = savePlayerBtn.innerHTML;
        savePlayerBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Speichern...';
        
        try {
            const response = await fetch('/myteam/addPlayer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ name, number })
            });
            
            const result = await response.json();
            
            if (result.success) {
                showInfo('Spieler erfolgreich hinzugefügt!');
                setTimeout(() => {
                    location.reload();
                }, 1500);
            } else {
                showError(result.message || 'Fehler beim Hinzufügen des Spielers.');
            }
        } catch (error) {
            console.error('Error adding player:', error);
            showError('Fehler beim Hinzufügen des Spielers.');
        } finally {
            savePlayerBtn.disabled = false;
            savePlayerBtn.innerHTML = originalText;
        }
    });
    
    function showError(message) {
        hideMessages();
        addPlayerErrorText.textContent = message;
        addPlayerError.classList.remove('d-none');
    }
    
    function showInfo(message) {
        hideMessages();
        addPlayerInfoText.textContent = message;
        addPlayerInfo.classList.remove('d-none');
    }
    
    function hideMessages() {
        addPlayerError.classList.add('d-none');
        addPlayerInfo.classList.add('d-none');
    }
}
</script>

