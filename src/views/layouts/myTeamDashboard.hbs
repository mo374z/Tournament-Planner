<div class="container">
    <!-- Header Section -->
    <div class="page-divider">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 p-3 bg-dark text-white rounded">
            <h1 class="mb-2 mb-md-0">
                <i class="fas fa-users text-primary me-2"></i>{{viewTitle}}
            </h1>
            <a href="/myteam/logout" class="btn btn-outline-light">
                <i class="fas fa-sign-out-alt me-1"></i>Abmelden
            </a>
        </div>
    </div>
    
    <!-- Team Info Section -->
    <div class="page-divider">
        <div class="row g-4">
            <div class="col-lg-8">
                <!-- Team Basic Info -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-primary text-white">
                        <h2 class="card-title mb-0">
                            <i class="fas fa-info-circle me-2"></i>{{team.name}}
                        </h2>
                    </div>
                    <div class="card-body">
                        <div class="row text-center g-3 gy-4">
                            <div class="col-6 col-md-3">
                                <div class="stat-card group-stat">
                                    <div class="stat-icon">
                                        <i class="fas fa-layer-group"></i>
                                    </div>
                                    <div class="stat-value">{{team.group}}</div>
                                    <div class="stat-label">Gruppe</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="stat-card games-stat">
                                    <div class="stat-icon">
                                        <i class="fas fa-gamepad"></i>
                                    </div>
                                    <div class="stat-value">{{team.gamesPlayed}}</div>
                                    <div class="stat-label">Gespielt</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="stat-card goals-stat">
                                    <div class="stat-icon">
                                        <i class="fas fa-futbol"></i>
                                    </div>
                                    <div class="stat-value">{{team.goals.[0]}}:{{team.goals.[1]}}</div>
                                    <div class="stat-label">Tore</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="stat-card sekt-stat">
                                    <div class="stat-icon">
                                        <i class="fas fa-wine-bottle"></i>
                                    </div>
                                    <div class="stat-value">{{team.sektWon}}</div>
                                    <div class="stat-label">Sekt</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Game Results Breakdown -->
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h3 class="card-title mb-0">
                            <i class="fas fa-chart-bar me-2"></i>Spielergebnisse
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-4">
                                <div class="result-card win-card">
                                    <div class="result-icon">
                                        <i class="fas fa-trophy"></i>
                                    </div>
                                    <div class="result-number">{{team.gamesWon}}</div>
                                    <div class="result-label">Siege</div>
                                    <div class="result-progress">
                                        <div class="progress">
                                            <div class="progress-bar bg-success" style="width: {{percentage team.gamesWon team.gamesPlayed}}%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="result-card draw-card">
                                    <div class="result-icon">
                                        <i class="fas fa-equals"></i>
                                    </div>
                                    <div class="result-number">{{team.gamesDraw}}</div>
                                    <div class="result-label">Unentsch.</div>
                                    <div class="result-progress">
                                        <div class="progress">
                                            <div class="progress-bar bg-warning" style="width: {{percentage team.gamesDraw team.gamesPlayed}}%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="result-card loss-card">
                                    <div class="result-icon">
                                        <i class="fas fa-times-circle"></i>
                                    </div>
                                    <div class="result-number">{{team.gamesLost}}</div>
                                    <div class="result-label">Niederlagen</div>
                                    <div class="result-progress">
                                        <div class="progress">
                                            <div class="progress-bar bg-danger" style="width: {{percentage team.gamesLost team.gamesPlayed}}%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="row g-3">
                    <!-- Team Logo (jetzt zuerst) -->
                    {{#if team.logo.path}}
                    <div class="col-12">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header bg-info text-white">
                                <h2 class="card-title mb-0">
                                    <i class="fas fa-shield-alt me-2"></i>Team Logo
                                </h2>
                            </div>
                            <div class="card-body text-center d-flex align-items-center justify-content-center">
                                {{#if mainSettings.myTeamPageOptions.allowLogoUpload}}
                                <div class="team-logo-clickable" style="cursor: pointer;" 
                                     data-bs-toggle="modal" data-bs-target="#teamLogoModal"
                                     onclick="showLogoModal('{{team.logo.path}}', '{{team.name}}', '{{team._id}}')">
                                    {{{logoDiv team.logo team.name 150 150}}}
                                </div>
                                <small class="text-muted mt-2 position-absolute" style="bottom: 1px; font-size: 0.75rem;">
                                    <i class="fas fa-eye me-1"></i>Klick zum Vergrößern &
                                     um das Logo zu bearbeiten <i class="fas fa-edit me-1"></i>
                                </small>
                                {{else}}
                                <div>
                                    {{{logoDiv team.logo team.name 150 150}}}
                                </div>
                                <small class="text-muted mt-2 position-absolute" style="bottom: 1px; font-size: 0.75rem;">
                                    <i class="fas fa-eye me-1"></i>Logo-Anzeige (Bearbeitung nicht verfügbar)
                                </small>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                    {{/if}}
                    
                    <!-- Team Image (jetzt nach dem Logo) -->
                    {{#if team.imagePath}}
                    <div class="col-12">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header bg-secondary text-white">
                                <h2 class="card-title mb-0">
                                    <i class="fas fa-image me-2"></i>Team Bild
                                </h2>
                            </div>
                            <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
                                <img src="{{team.imagePath}}" alt="{{team.name}}" class="img-fluid rounded shadow team-image-clickable" 
                                     style="max-height: 200px; cursor: pointer;" 
                                     data-bs-toggle="modal" data-bs-target="#teamImageModal"
                                     onclick="showImageModal('{{team.imagePath}}', '{{team.name}}', '{{team._id}}')">
                                <small class="text-muted mt-2">
                                    <i class="fas fa-eye me-1"></i>Klick zum Vergrößern &
                                    {{#if mainSettings.myTeamPageOptions.allowImageUpload}}
                                    <br><i class="fas fa-upload me-1"></i> um ein neues Bild hochzuladen
                                    {{/if}}
                                </small>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                    
                    <!-- Fallback wenn weder Logo noch Bild vorhanden -->
                    {{#unless (or team.logo.path team.imagePath)}}
                    <div class="col-12">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center d-flex align-items-center justify-content-center">
                                <div class="text-muted">
                                    <i class="fas fa-image fa-3x mb-3"></i>
                                    <p>Kein Team-Logo oder Bild verfügbar</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/unless}}
                </div>
            </div>
        </div>
    </div>
    
    <!-- Upcoming Games Section -->
    <div class="page-divider">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h2 class="card-title mb-0">
                    <i class="fas fa-calendar-alt me-2"></i>Kommende Spiele
                </h2>
            </div>
            <div class="card-body">
                {{#if upcomingGames.length}}
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th><i class="fas fa-hashtag me-1"></i>SpielNr.</th>
                                    <th><i class="fas fa-clock me-1"></i>Uhrzeit</th>
                                    <th class="d-none d-md-table-cell"><i class="fas fa-gamepad me-1"></i>Spiel</th>
                                    <th><i class="fas fa-users me-1"></i>Gegner</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each upcomingGames}}
                                <tr>
                                    <td class="fw-bold">{{number}}</td>
                                    <td><span class="badge bg-info">{{formattedTime}}</span></td>
                                    <td class="d-none d-md-table-cell">{{gameDisplayName}}</td>
                                    <td><strong>{{opponent.name}}</strong></td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                {{else}}
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-calendar-times fa-3x mb-3"></i>
                        <p class="mb-0">Keine kommenden Spiele</p>
                    </div>
                {{/if}}
            </div>
        </div>
    </div>
    
    <!-- Past Games Section -->
    <div class="page-divider">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h2 class="card-title mb-0">
                    <i class="fas fa-history me-2"></i>Bisherige Spiele
                </h2>
            </div>
            <div class="card-body">
                {{#if pastGames.length}}
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th><i class="fas fa-hashtag me-1"></i>SpielNr.</th>
                                    <th><i class="fas fa-clock me-1"></i>Uhrzeit</th>
                                    <th class="d-none d-md-table-cell"><i class="fas fa-gamepad me-1"></i>Spiel</th>
                                    <th><i class="fas fa-users me-1"></i>Gegner</th>
                                    <th><i class="fas fa-futbol me-1"></i>Ergebnis</th>
                                    <th class="d-none d-sm-table-cell"><i class="fas fa-medal me-1"></i>Resultat</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each pastGames}}
                                <tr>
                                    <td class="fw-bold">{{number}}</td>
                                    <td><span class="badge bg-secondary">{{formattedTime}}</span></td>
                                    <td class="d-none d-md-table-cell">{{gameDisplayName}}</td>
                                    <td><strong>{{opponent.name}}</strong></td>
                                    <td>
                                        {{#if goals}}
                                            <span class="badge bg-primary"><strong>{{goals.[0]}}</strong> : {{goals.[1]}}</span>
                                        {{else}}
                                            <span class="text-muted">-</span>
                                        {{/if}}
                                    </td>
                                    <td class="d-none d-sm-table-cell">
                                        <span class="badge 
                                            {{#if (stringeq winner.name 'Unentschieden')}}bg-secondary
                                            {{else}}{{#if (eq winner.id team._id)}}bg-success
                                            {{else}}bg-danger{{/if}}{{/if}}">
                                            {{#if (stringeq winner.name 'Unentschieden')}}Unentschieden
                                            {{else}}{{#if (eq winner.id team._id)}}Gewonnen
                                            {{else}}Verloren{{/if}}{{/if}}
                                        </span>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                {{else}}
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-calendar-times fa-3x mb-3"></i>
                        <p class="mb-0">Keine bisherigen Spiele</p>
                    </div>
                {{/if}}
            </div>
        </div>
    </div>
    
    <!-- Team Players Section -->
    <div class="page-divider">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h2 class="card-title mb-0">
                    <i class="fas fa-users me-2"></i>Unsere Spieler
                </h2>
            </div>
            <div class="card-body">
                {{#if players.length}}
                    <div class="row g-3">
                        {{#each players}}
                        <div class="col-md-6 col-lg-4">
                            <div class="player-card p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="player-number me-3">
                                        {{#if number}}
                                        <div class="number-badge">
                                            {{number}}
                                        </div>
                                        {{else}}
                                        <div class="number-badge no-number">
                                            ?
                                        </div>
                                        {{/if}}
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="mb-1">{{name}}</h5>
                                        {{#if position}}
                                        <small class="text-muted">{{position}}</small>
                                        {{/if}}
                                        {{#if total_goals}}
                                        <div class="player-stats">
                                            <small class="text-success">
                                                <i class="fas fa-futbol me-1"></i>{{total_goals}} Tore
                                            </small>
                                        </div>
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                {{else}}
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-user-friends fa-3x mb-3"></i>
                        <p class="mb-0">Noch keine Spieler hinzugefügt</p>
                    </div>
                {{/if}}
                
                {{#if mainSettings.myTeamPageOptions.allowPlayerAdd}}
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addPlayerModal">
                        <i class="fas fa-user-plus me-2"></i>Spieler hinzufügen
                    </button>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
    
    <!-- Certificate Download Section -->
    {{#if mainSettings.myTeamPageOptions.allowCertificateDownload}}
    <div class="page-divider">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h2 class="card-title mb-0">
                    <i class="fas fa-certificate me-2"></i>Urkunde
                </h2>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="fas fa-award fa-3x text-warning mb-2"></i>
                    <p class="text-muted">Laden Sie Ihre Team-Urkunde herunter</p>
                </div>
                <a href="/myteam/downloadCertificate" class="btn btn-warning btn-lg">
                    <i class="fas fa-download me-2"></i>Urkunde downloaden
                </a>
                <div class="mt-2">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>Die Urkunde wird als Word-Dokument (.docx) heruntergeladen
                    </small>
                </div>
            </div>
        </div>
    </div>
    {{/if}}
    
    <!-- Footer Section -->
    <div class="text-center my-4">
        <a href="/myteam/logout" class="btn btn-outline-secondary">
            <i class="fas fa-sign-out-alt me-1"></i>Abmelden
        </a>
    </div>
</div>

{{#if mainSettings.myTeamPageOptions.allowPlayerAdd}}
<!-- Add Player Modal -->
<div class="modal fade" id="addPlayerModal" tabindex="-1" aria-labelledby="addPlayerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addPlayerModalLabel">
                    <i class="fas fa-user-plus me-2"></i>Neuen Spieler hinzufügen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <form id="addPlayerForm">
                    <div class="mb-3">
                        <label for="playerName" class="form-label">
                            <i class="fas fa-user me-1"></i>Spielername <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="playerName" name="name" required maxlength="50" placeholder="Name des Spielers">
                        <div class="form-text">Pflichtfeld - Name des neuen Spielers</div>
                    </div>
                    <div class="mb-3">
                        <label for="playerNumber" class="form-label">
                            <i class="fas fa-hashtag me-1"></i>Trikotnummer
                        </label>
                        <input type="text" class="form-control" id="playerNumber" name="number" maxlength="15" placeholder="z.B. 10">
                        <div class="form-text">Optional - Trikotnummer des Spielers</div>
                    </div>
                    <div class="alert alert-info d-none" id="addPlayerInfo">
                        <i class="fas fa-info-circle me-1"></i>
                        <span id="addPlayerInfoText"></span>
                    </div>
                    <div class="alert alert-danger d-none" id="addPlayerError">
                        <i class="fas fa-exclamation-circle me-1"></i>
                        <span id="addPlayerErrorText"></span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Abbrechen
                </button>
                <button type="button" class="btn btn-success" id="savePlayerBtn">
                    <i class="fas fa-user-plus me-2"></i>Spieler hinzufügen
                </button>
            </div>
        </div>
    </div>
</div>
{{/if}}

<!-- Team Image Modal -->
<div class="modal fade" id="teamImageModal" tabindex="-1" aria-labelledby="teamImageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="teamImageModalLabel">
                    <i class="fas fa-image me-2"></i><span id="modalTeamName">Team Bild</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalTeamImage" src="" alt="" class="img-fluid rounded shadow" style="max-width: 100%; max-height: 60vh; margin-bottom: 1rem;">
                
                <!-- Upload Section in Modal -->
                {{#if mainSettings.myTeamPageOptions.allowImageUpload}}
                <div class="border-top pt-3">
                    <h6 class="mb-3"><i class="fas fa-upload me-2"></i>Neues Team-Bild hochladen <br>(Zuerst mit "Browse auswählen und dann hochladen drücken")</h6>
                    <form action="/myteam/uploadImage" method="POST" enctype="multipart/form-data" class="d-flex flex-column gap-2">
                        <input type="hidden" name="teamId" id="modalTeamId" value="">
                        <div class="input-group">
                            <input type="file" class="form-control" id="modalTeamImage" name="teamImage" accept="image/*" required>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-cloud-upload-alt me-1"></i>Hochladen
                            </button>
                        </div>
                        <small class="text-muted">Erlaubte Formate: JPG, PNG, GIF (max. 5 MB)</small>
                    </form>
                </div>
                {{/if}}
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success" id="downloadImageBtn" onclick="downloadImage()">
                    <i class="fas fa-download me-2"></i>Bild herunterladen
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Schließen
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Team Logo Modal -->
<div class="modal fade" id="teamLogoModal" tabindex="-1" aria-labelledby="teamLogoModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="teamLogoModalLabel">
                    <i class="fas fa-shield-alt me-2"></i>Team Logo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                {{#if mainSettings.myTeamPageOptions.allowLogoUpload}}
                <!-- Logo Upload -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h6><i class="fas fa-upload me-2"></i>Neues Logo hochladen</h6>
                        <form id="logoUploadForm" action="/myteam/uploadLogo" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="teamId" id="logoTeamId">
                            <div class="row">
                                <div class="col-md-8">
                                    <input type="file" class="form-control" id="logoFileInput" name="teamLogo" accept="image/*" required>
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fas fa-upload me-2"></i>Logo hochladen
                                    </button>
                                </div>
                            </div>
                            <small class="form-text text-muted">
                                Unterstützte Formate: JPG, PNG, GIF (Max. 5MB)
                            </small>
                        </form>
                    </div>
                </div>
                <hr>
                {{/if}}
                
                <!-- Logo Bearbeitung - genau wie Team Details -->
                <div class="team-logo" style="background-color: #f8f9fa; padding: 30px; border-radius: 10px;">
                    <p class="text-muted mb-4 text-center">
                        <i class="fa fa-info-circle"></i> 
                        <strong>Anleitung:</strong> Logo im Kreis an passende Position schieben und Größe anpassen. <br> Dann auf "Speichern" klicken !
                    </p>
                    
                    <!-- Logo Container - zentriert -->
                    <div class="text-center mb-5" style="padding: 50px 60px;">
                        <div style="position: relative; display: inline-block;">
                            <!-- Pfeil nach oben -->
                            <div style="position: absolute; top: -35px; left: 50%; transform: translateX(-50%);">
                                <button type="button" id="myteam-move-up" class="btn btn-outline-primary btn-sm" style="padding: 5px 10px;">
                                    <i class="fa fa-arrow-up"></i>
                                </button>
                            </div>
                            
                            <!-- Pfeil nach links -->
                            <div style="position: absolute; top: 50%; left: -45px; transform: translateY(-50%);">
                                <button type="button" id="myteam-move-left" class="btn btn-outline-primary btn-sm" style="padding: 5px 10px;">
                                    <i class="fa fa-arrow-left"></i>
                                </button>
                            </div>
                            
                            <!-- Pfeil nach rechts -->
                            <div style="position: absolute; top: 50%; right: -45px; transform: translateY(-50%);">
                                <button type="button" id="myteam-move-right" class="btn btn-outline-primary btn-sm" style="padding: 5px 10px;">
                                    <i class="fa fa-arrow-right"></i>
                                </button>
                            </div>
                            
                            <!-- Pfeil nach unten -->
                            <div style="position: absolute; bottom: -35px; left: 50%; transform: translateX(-50%);">
                                <button type="button" id="myteam-move-down" class="btn btn-outline-primary btn-sm" style="padding: 5px 10px;">
                                    <i class="fa fa-arrow-down"></i>
                                </button>
                            </div>
                            
                            <!-- Logo Container -->
                            <div id="myteam-logo-container" 
                                 style="position: relative; 
                                        width: 150px; 
                                        height: 150px; 
                                        border-radius: 50%; 
                                        overflow: hidden; 
                                        border: 3px solid #007bff; 
                                        margin: 0 auto; 
                                        background: #f8f9fa;"
                                 data-container-width="150"
                                 data-container-height="150">
                                <img id="myteam-logo-img" 
                                     src="" 
                                     alt="Team Logo" 
                                     style="position: absolute; 
                                            transform-origin: center center;
                                            transform: translate(-50%, -50%) scale(0.5);
                                            left: 50%;
                                            top: 50%;
                                            max-width: none;
                                            cursor: move;"
                                     data-normalized-x="0.5"
                                     data-normalized-y="0.5">
                            </div>
                        </div>
                    </div>
                    
                    {{#if mainSettings.myTeamPageOptions.allowLogoUpload}}
                    <!-- Zentrieren Buttons -->
                    <div class="text-center mb-4">
                        <button type="button" id="myteam-center-horizontal" class="btn btn-outline-primary btn-sm mx-2">Horizontal zentrieren</button>
                        <button type="button" id="myteam-center-vertical" class="btn btn-outline-primary btn-sm mx-2">Vertikal zentrieren</button>
                    </div>
                    
                    <!-- Größe Regler -->
                    <div class="text-center mb-4">
                        <label for="myteam-logo-scale" class="form-label"><strong>Größe:</strong></label><br>
                        <div style="display: inline-block; width: 300px;">
                            <input type="range" id="myteam-logo-scale" min="0.05" max="1.5" step="0.05" 
                                   value="0.5" 
                                   class="form-range" style="width: 100%;">
                            <div class="text-center mt-1">
                                <span id="myteam-scale-value" style="font-weight: bold;">0.5</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Hintergrundfarbe -->
                    <div class="text-center mb-4">
                        <label for="myteam-background-color" class="form-label"><strong>Hintergrundfarbe:</strong></label><br>
                        <input type="color" id="myteam-background-color" 
                               value="#f8f9fa"
                               class="form-control" style="width: 100px; height: 40px; margin: 0 auto;">
                    </div>
                    
                    <!-- Zurücksetzen und Speichern -->
                    <div class="text-center mb-4">
                        <button type="button" id="myteam-save-logo-position" class="btn btn-success btn-lg d-block w-100 mb-2">Speichern</button>
                        <button type="button" id="myteam-reset-logo" class="btn btn-secondary d-block w-100">Zurücksetzen auf Standard</button>
                    </div>
                    {{else}}
                    <div class="text-center">
                        <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Logo-Bearbeitung ist nicht aktiviert.</p>
                    </div>
                    {{/if}}
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen & Schließen</button>
            </div>
        </div>
    </div>
</div>

