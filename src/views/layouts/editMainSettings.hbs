<div class="container-fluid" style="max-width: 1400px; margin: 0 auto; padding: 20px;">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="display-6 mb-3">
                <i class="fas fa-cogs text-primary me-3"></i>Tournament Settings
            </h1>
            <p class="text-muted lead">Verwalten Sie alle Einstellungen für das Turnier</p>
        </div>
    </div>

    <!-- Custom CSS for tabs -->
    <style>
        .tab-content {
            border: 1px solid #dee2e6;
            border-top: none;
            border-radius: 0 0 0.375rem 0.375rem;
            padding: 1.5rem;
            background: #fff;
        }
        .tab-pane {
            padding-top: 0;
        }
        .card {
            margin-bottom: 1rem;
        }
    </style>

    <!-- Main Content Tabs -->
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tournament-tab" data-bs-toggle="tab" data-bs-target="#tournament-tab-pane" type="button" role="tab" aria-controls="tournament-tab-pane" aria-selected="true">
                <i class="fas fa-trophy me-2"></i>Turnier
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="database-tab" data-bs-toggle="tab" data-bs-target="#database-tab-pane" type="button" role="tab" aria-controls="database-tab-pane" aria-selected="false">
                <i class="fas fa-database me-2"></i>Datenbank
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="display-tab" data-bs-toggle="tab" data-bs-target="#display-tab-pane" type="button" role="tab" aria-controls="display-tab-pane" aria-selected="false">
                <i class="fas fa-desktop me-2"></i>Anzeige
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-tab-pane" type="button" role="tab" aria-controls="users-tab-pane" aria-selected="false">
                <i class="fas fa-users me-2"></i>Benutzer & MyTeam
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="stats-tab" data-bs-toggle="tab" data-bs-target="#stats-tab-pane" type="button" role="tab" aria-controls="stats-tab-pane" aria-selected="false">
                <i class="fas fa-chart-bar me-2"></i>Statistiken
            </button>
        </li>
    </ul>

    <div class="tab-content" id="myTabContent">
        <!-- Tournament Tab -->
        <div class="tab-pane fade show active" id="tournament-tab-pane" role="tabpanel" aria-labelledby="tournament-tab" tabindex="0">
            <div class="row g-4">
                <!-- Tournament Settings -->
                <div class="col-lg-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Turnier-Einstellungen</h5>
                        </div>
                        <div class="card-body">
                            <form action="/mainSettings" method="POST" autocomplete="off">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="scheduleTemplate" class="form-label">Schedule Template:</label>
                                        <select id="scheduleTemplate" name="scheduleTemplate" required class="form-select">
                                            <option value="4groups_4teams.yaml" {{#if (eqref mainSettings.scheduleTemplate "4groups_4teams.yaml" )}}selected{{/if}}>4groups_4teams</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="TornamentStartTime" class="form-label">Tournament Start Time:</label>
                                        <input type="datetime-local" id="TornamentStartTime" name="TornamentStartTime"
                                            value="{{#if mainSettings.TornamentStartTime}}{{ formatDateTime mainSettings.TornamentStartTime }}{{/if}}"
                                            required class="form-control">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="timeBetweenGames" class="form-label">Zeit zwischen Spielen (min):</label>
                                        <input type="number" id="timeBetweenGames" name="timeBetweenGamesInMin"
                                            value="{{ milliToMin mainSettings.timeBetweenGames }}" required class="form-control">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="goalsforSekt" class="form-label">Tore für Sekt-Flasche:</label>
                                        <input type="number" id="goalsforSekt" name="goalsforSekt" value="{{ mainSettings.goalsforSekt }}"
                                            required class="form-control">
                                    </div>
                                </div>
                                
                                <hr class="my-4">
                                <h6 class="text-muted mb-3"><i class="fas fa-clock me-2"></i>Spieldauer pro Phase</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="gameDurationGroupStage" class="form-label">Gruppenphase (min):</label>
                                        <input type="number" id="gameDurationGroupStage" name="gameDurationGroupStageInMin"
                                            value="{{ milliToMin mainSettings.gameDurationGroupStage }}" required class="form-control">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="gameDurationQuarterfinals" class="form-label">Viertelfinale (min):</label>
                                        <input type="number" id="gameDurationQuarterfinals" name="gameDurationQuarterfinalsInMin"
                                            value="{{ milliToMin mainSettings.gameDurationQuarterfinals }}" required class="form-control">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="gameDurationSemifinals" class="form-label">Halbfinale (min):</label>
                                        <input type="number" id="gameDurationSemifinals" name="gameDurationSemifinalsInMin"
                                            value="{{ milliToMin mainSettings.gameDurationSemifinals }}" required class="form-control">
                                    </div>
                                    <div class="col-md-6">
                                        <label for="gameDurationFinal" class="form-label">Finale (min):</label>
                                        <input type="number" id="gameDurationFinal" name="gameDurationFinalInMin"
                                            value="{{ milliToMin mainSettings.gameDurationFinal }}" required class="form-control">
                                    </div>
                                    <div class="col-12">
                                        <label for="timeBetweenGamePhases" class="form-label">Zeit zwischen Phasen (min):</label>
                                        <input type="number" id="timeBetweenGamePhases" name="timeBetweenGamePhasesInMin"
                                            value="{{ milliToMin mainSettings.timeBetweenGamePhases }}" required class="form-control">
                                    </div>
                                </div>
                                
                                <div class="d-grid mt-4">
                                    <button id="saveSettings" type="submit" class="btn btn-primary btn-lg">
                                        <i class="fas fa-save me-2"></i>Turnier-Einstellungen speichern
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Schedule & Groups -->
                <div class="col-lg-6">
                    <div class="row g-4">
                        <!-- Schedule Generation -->
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0"><i class="fas fa-calendar-plus me-2"></i>Spielplan generieren</h5>
                                </div>
                                <div class="card-body text-center">
                                    <p class="text-muted">Erstellt einen komplett neuen Spielplan</p>
                                    <a href="/schedule/generate" class="btn btn-success btn-lg" role="button"
                                        onclick="return confirm('Bist du sicher, dass du einen neuen Spielplan generieren möchtest? (Davor am besten alle Zähler löschen !)');">
                                        <i class="fas fa-magic me-2"></i>Neuen Spielplan generieren
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Group Management -->
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0"><i class="fas fa-layer-group me-2"></i>Gruppen-Verwaltung</h5>
                                </div>
                                <div class="card-body">
                                    <form action="/mainSettings/addGroups" method="POST" class="mb-3">
                                        <div class="input-group">
                                            <input type="number" class="form-control" id="nGroups" name="nGroups" required placeholder="Anzahl Gruppen zum hinzufügen" min="1" max="16" autocomplete="off">
                                            <button type="submit" class="btn btn-info">
                                                <i class="fas fa-plus me-2"></i>Hinzufügen
                                            </button>
                                        </div>
                                    </form>

                                    <h6 class="text-muted mb-3">Vorhandene Gruppen:</h6>
                                    <div class="d-grid gap-2">
                                        {{#each mainSettings.groups}}
                                        <div class="d-flex justify-content-between align-items-center p-3 bg-light border rounded">
                                            <h5 class="mb-0 text-primary">
                                                <i class="fas fa-layer-group me-2"></i>
                                                <strong>Gruppe {{this}}</strong>
                                            </h5>
                                            <form action="/mainSettings/deleteGroup" method="POST" style="display:inline;">
                                                <input type="hidden" name="groupName" value="{{this}}">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Sind Sie sicher, dass Sie Gruppe {{this}} löschen möchten?')"
                                                    title="Gruppe {{this}} löschen">
                                                    <i class="fas fa-trash me-1"></i>Löschen
                                                </button>
                                            </form>
                                        </div>
                                        {{/each}}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Database Tab -->
        <div class="tab-pane fade" id="database-tab-pane" role="tabpanel" aria-labelledby="database-tab" tabindex="0">
            <div class="row g-4">
                <!-- Current Database -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0"><i class="fas fa-server me-2"></i>Aktuelle Datenbank</h5>
                        </div>
                        <div class="card-body text-center">
                            <h3 class="text-danger mb-0">{{dbName}}</h3>
                            <p class="text-muted mt-2">Derzeit aktive Datenbank</p>
                        </div>
                    </div>
                </div>

                <!-- Database Operations -->
                <div class="col-lg-8">
                    <div class="row g-3">
                        <!-- Create Database -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Neue Datenbank erstellen</h6>
                                </div>
                                <div class="card-body">
                                    <form action="/mainSettings/createDb" method="post">
                                        <div class="mb-3">
                                            <label for="dbName" class="form-label">Datenbankname:</label>
                                            <input type="text" id="dbName" name="dbName" pattern="^[^\s]+$" required
                                                autocomplete="off" maxlength="20" class="form-control">
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100"
                                            onclick="return confirm('Are you sure you want to create a new database?\nEin Benutzer wird angelegt admin, admin')">
                                            <i class="fas fa-database me-2"></i>Erstellen
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Switch Database -->
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-warning text-dark">
                                    <h6 class="mb-0"><i class="fas fa-exchange-alt me-2"></i>Datenbank wechseln</h6>
                                </div>
                                <div class="card-body">
                                    <form action="/mainSettings/switchDb" method="post">
                                        <div class="mb-3">
                                            <label for="dbSwitchName" class="form-label">Verfügbare Datenbanken:</label>
                                            <select id="dbSwitchName" name="dbName" required class="form-select">
                                                {{#each dbs}}
                                                <option value="{{this.name}}">{{this.name}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                        <button type="submit" class="btn btn-warning w-100"
                                            onclick="return confirm('Are you sure you want to switch the database?\nEs kann nur zu einer DB gewechselt werden, die entsprechende collections enthält!')">
                                            <i class="fas fa-sync me-2"></i>Wechseln
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Backup Operations -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="fas fa-shield-alt me-2"></i>Backup & Restore</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-3">
                                <a href="/mainSettings/backupDB" class="btn btn-success">
                                    <i class="fas fa-download me-2"></i>Backup erstellen
                                </a>
                                
                                <hr class="my-2">
                                
                                <form action="/mainSettings/restoreDB" method="post">
                                    <div class="mb-3">
                                        <label for="dbRestoreName" class="form-label">Backup auswählen:</label>
                                        <select id="dbRestoreName" name="dbRestoreName" required class="form-select">
                                            {{#each backupDbs}}
                                            <option value="{{this}}">{{this}}</option>
                                            {{/each}}
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-outline-success w-100"
                                        onclick="return confirmRestore()">
                                        <i class="fas fa-upload me-2"></i>Backup wiederherstellen
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Available Databases -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="fas fa-list me-2"></i>Verfügbare Datenbanken</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Datenbankname</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each dbs}}
                                        <tr>
                                            <td>{{@index}}</td>
                                            <td>{{this.name}}</td>
                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Display Tab -->
        <div class="tab-pane fade" id="display-tab-pane" role="tabpanel" aria-labelledby="display-tab" tabindex="0">
            <div class="row g-4">
                <!-- Public Page Settings -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-globe me-2"></i>Öffentliche Hauptseite</h5>
                        </div>
                        <div class="card-body">
                            <form action="/mainSettings/publicPageSettings" method="POST" autocomplete="off">
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="showAdvertisingPosters" name="showAdvertisingPosters" {{#if mainSettings.publicPageOptions.showAdvertisingPosters}}checked{{/if}}>
                                    <label class="form-check-label" for="showAdvertisingPosters">
                                        <i class="fas fa-image me-2"></i>Werbeplakate anzeigen
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="showRankingTable" name="showRankingTable" {{#if mainSettings.publicPageOptions.showRankingTable}}checked{{/if}}>
                                    <label class="form-check-label" for="showRankingTable">
                                        <i class="fas fa-trophy me-2"></i>Rangliste anzeigen
                                    </label>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i>Speichern
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Live Game Page Settings -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="fas fa-tv me-2"></i>Live Game Seite</h5>
                        </div>
                        <div class="card-body">
                            <form action="/mainSettings/liveGamePageSettings" method="POST" autocomplete="off">
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="showTeamLogos" name="showTeamLogos" {{#if mainSettings.liveGamePageOptions.showTeamLogos}}checked{{/if}}>
                                    <label class="form-check-label" for="showTeamLogos">
                                        <i class="fas fa-shield-alt me-2"></i>Team-Logos anzeigen
                                    </label>
                                </div>
                                <small class="text-muted mb-3 d-block">
                                    <i class="fas fa-info-circle me-1"></i>Bitte danach die Live Game Seite neu laden!
                                </small>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-save me-2"></i>Speichern
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Feedback Management -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="fas fa-comment-dots me-2"></i>Feedback System</h5>
                        </div>
                        <div class="card-body">
                            <form action="/mainSettings/feedbackSettings" method="POST" autocomplete="off" class="mb-3">
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="enableFeedback" name="enableFeedback" {{#if mainSettings.feedbackOptions.enableFeedback}}checked{{/if}}>
                                    <label class="form-check-label" for="enableFeedback">
                                        <i class="fas fa-toggle-on me-2"></i>Feedback System aktivieren
                                    </label>
                                </div>
                                <div class="d-grid mb-3">
                                    <button type="submit" class="btn btn-info">
                                        <i class="fas fa-save me-2"></i>Speichern
                                    </button>
                                </div>
                            </form>
                            <div class="d-grid">
                                <a href="/feedback/list" class="btn btn-outline-info">
                                    <i class="fas fa-comments me-2"></i>Feedback verwalten
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users & Teams Tab -->
        <div class="tab-pane fade" id="users-tab-pane" role="tabpanel" aria-labelledby="users-tab" tabindex="0">
            <div class="row g-4">
                <!-- User Management -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0"><i class="fas fa-users me-2"></i>Benutzerverwaltung</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <a href="user/register" class="btn btn-outline-secondary">
                                    <i class="fas fa-user-plus me-2"></i>Neuen Benutzer registrieren
                                </a>
                                <a href="user/list" class="btn btn-outline-secondary">
                                    <i class="fas fa-list me-2"></i>Benutzer auflisten
                                </a>
                                <a href="user/deleteAdmin" class="btn btn-outline-danger">
                                    <i class="fas fa-user-times me-2"></i>Admin-Benutzer löschen
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MyTeam Management -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-users-cog me-2"></i>MyTeam System</h5>
                        </div>
                        <div class="card-body">
                            <form action="/mainSettings/myTeamSettings" method="POST" autocomplete="off" class="mb-3">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="myTeamEnabled" name="myTeamEnabled" {{#if mainSettings.myTeamPageOptions.myTeamEnabled}}checked{{/if}}>
                                    <label class="form-check-label" for="myTeamEnabled">
                                        <i class="fas fa-toggle-on me-1"></i>MyTeam aktivieren
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="allowImageUpload" name="allowImageUpload" {{#if mainSettings.myTeamPageOptions.allowImageUpload}}checked{{/if}}>
                                    <label class="form-check-label" for="allowImageUpload">
                                        <i class="fas fa-image me-1"></i>Team-Bild Upload erlauben
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="allowLogoUpload" name="allowLogoUpload" {{#if mainSettings.myTeamPageOptions.allowLogoUpload}}checked{{/if}}>
                                    <label class="form-check-label" for="allowLogoUpload">
                                        <i class="fas fa-shield-alt me-1"></i>Team-Logo Upload/Bearbeitung erlauben
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="allowPlayerAdd" name="allowPlayerAdd" {{#if mainSettings.myTeamPageOptions.allowPlayerAdd}}checked{{/if}}>
                                    <label class="form-check-label" for="allowPlayerAdd">
                                        <i class="fas fa-user-plus me-1"></i>Spieler hinzufügen erlauben
                                    </label>
                                </div>
                                <div class="d-grid mb-3">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i>MyTeam-Einstellungen speichern
                                    </button>
                                </div>
                            </form>
                            
                            <div class="alert alert-info" role="alert">
                                <i class="fas fa-info-circle me-2"></i>
                                <small>Aktiviert den MyTeam-Bereich, in dem Teams mit ihren Zugangscodes ihre eigenen Daten einsehen können.</small>
                            </div>
                            
                            <hr>
                            <h6 class="text-muted mb-2">Team-Dateien verwalten</h6>
                            <div class="d-grid">
                                <a href="/mainSettings/cleanupTeamFiles" class="btn btn-warning" 
                                   onclick="return confirm('Sind Sie sicher, dass Sie alle ungenutzten Team-Bilder und Logos löschen möchten?\n\nDies kann nicht rückgängig gemacht werden!')">
                                    <i class="fas fa-trash-alt me-2"></i>Ungenutzte Dateien löschen
                                </a>
                            </div>
                            <small class="text-muted mt-2 d-block">
                                <i class="fas fa-exclamation-triangle me-1"></i>Löscht alle Team-Bilder und Logos, die nicht mit einem Team verknüpft sind.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics Tab -->
        <div class="tab-pane fade" id="stats-tab-pane" role="tabpanel" aria-labelledby="stats-tab" tabindex="0">
            <div class="row g-4">
                <!-- General Counters -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="fas fa-calculator me-2"></i>Allgemeine Zähler</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <div class="border rounded p-3">
                                        <h4 class="text-success mb-1">{{ generalCounters.allGoals }}</h4>
                                        <small class="text-muted">Alle Tore</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-3">
                                        <h4 class="text-primary mb-1">{{ generalCounters.gamesPlayed }}</h4>
                                        <small class="text-muted">Gespielte Spiele</small>
                                    </div>
                                </div>
                                <div class="col-6 mt-3">
                                    <div class="border rounded p-3">
                                        <h4 class="text-warning mb-1">{{ generalCounters.goalSektCounter }}</h4>
                                        <small class="text-muted">Tor-Sekt Zähler</small>
                                    </div>
                                </div>
                                <div class="col-6 mt-3">
                                    <div class="border rounded p-3">
                                        <h4 class="text-info mb-1">{{ generalCounters.wonSektBottles }}</h4>
                                        <small class="text-muted">Gewonnene Sektflaschen</small>
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <a href="mainSettings/resetCounters" class="btn btn-outline-danger"
                                    onclick="return confirm('Willst du wirklich alle Zähler löschen ?');">
                                    <i class="fas fa-trash me-2"></i>Allgemeine Zähler löschen
                                </a>
                                <a href="/team/clearTeamCounters" class="btn btn-outline-danger"
                                    onclick="return confirm('Are you sure you want to clear all team counters?');">
                                    <i class="fas fa-users me-2"></i>Team-Zähler löschen
                                </a>
                                <a href="#" onclick="resetPlayers()" class="btn btn-outline-danger">
                                    <i class="fas fa-user me-2"></i>Spieler-Statistiken löschen
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Visitor Statistics -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Besucherstatistiken</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <div class="bg-light rounded p-4">
                                        <h3 class="text-primary mb-1">{{ generalCounters.totalPageViews }}</h3>
                                        <small class="text-muted">Gesamte Seitenaufrufe</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light rounded p-4">
                                        <h3 class="text-success mb-1">{{ generalCounters.uniqueVisitors }}</h3>
                                        <small class="text-muted">Eindeutige Besucher</small>
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid">
                                <a href="/mainSettings/resetVisitorCounters" class="btn btn-warning"
                                    onclick="return confirm('Are you sure you want to reset all visitor counters?');">
                                    <i class="fas fa-chart-line me-2"></i>Besucher-Zähler zurücksetzen
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function resetPlayers() {
        if (confirm('Sind Sie sicher, dass Sie alle Tore der Spieler zurücksetzen möchten?')) {
            fetch('/player/reset-total-goals', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            }).then(response => {
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Fehler beim Zurücksetzen...');
                }
            });
        }
    }

    function confirmRestore() {
        const selectedBackup = document.getElementById('dbRestoreName').value;
        //TournamentDB_15.1.2026_18-59-04.gz
        const dbName = selectedBackup.split('_')[0];
        const date = selectedBackup.split('_')[1];
        let time = selectedBackup.split('_')[2];
        time = time.substring(0, time.length - 6);
        time = time.replace('-', ':');
        const dateFormatted = date.replace(/-/g, '.').replace(/_/g, ':');
        return confirm(`Bist du sicher, dass du das Backup vom ${dateFormatted} von ${time} wiederherstellen möchtest?\n\n` +
            `!! Das überschreibt die aktuelle DB in Mongo: ${dbName} mit den Daten aus dem Bakup!!!`);
    }
</script>

