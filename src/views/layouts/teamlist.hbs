<div class="text-center">
    <h1 >Teamverwaltung</h1>
    <hr>
</div>
<div class="container">
  <div class="row">
    <div class="col-lg-6 mb-4">
    <h2>Neues Team hinzufügen</h2>
    <form action="/team/add" method="POST" onsubmit="return validateForm()">
        <div class="form-group">
            <label for="name">Name:</label>
            <input type="text" class="form-control" id="name" name="name" value="" required>
        </div>
        <div class="form-group">
            <label for="group">Gruppe auswählen (Gruppen sind in der <a href="/mainSettings">Einstellungen</a> verwaltbar):</label>
            <select class="form-control" id="group" name="group" required>
                <option value="__none__">Keine (None)</option>
                {{#each groups}}
                    <option value="{{this}}">{{this}}</option>
                {{/each}}
            </select>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Hinzufügen</button>
    </form>
    </div>
    <div class="col-lg-6 mb-4">
    <h2>Team einer Gruppe zuordnen</h2>
    <form action="/team/assignGroup" method="POST" onsubmit="return validateAssign()" autocomplete="off">
        <input type="hidden" id="assignTeamId" name="teamId" value="">
        <div class="form-group position-relative">
            <label for="teamSearch">Team suchen (Anfangsbuchstaben tippen):</label>
            <input type="text" class="form-control" id="teamSearch" placeholder="Teamname">
            <div id="teamSuggestions" class="list-group position-absolute w-100" style="z-index: 1000; max-height: 220px; overflow-y: auto;"></div>
        </div>
        <div class="form-group">
            <label for="assignGroup">Gruppe:</label>
            <select class="form-control" id="assignGroup" name="group" required>
                {{#each groups}}
                    <option value="{{this}}">{{this}}</option>
                {{/each}}
            </select>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Team Gruppe zuordnen</button>
    </form>
    </div>
  </div>
</div>
<script>
const assignableTeams = [
    {{#each list}}{ id: "{{this.id}}", name: "{{this.name}}", group: "{{this.group}}" },
    {{/each}}
];

function validateAssign() {
    if (!document.getElementById('assignTeamId').value) {
        alert('Bitte ein Team aus den Vorschlägen auswählen.');
        return false;
    }
    return true;
}

document.addEventListener('DOMContentLoaded', function () {
    const input = document.getElementById('teamSearch');
    const box = document.getElementById('teamSuggestions');
    const idField = document.getElementById('assignTeamId');

    function render() {
        const q = input.value.trim().toLowerCase();
        idField.value = '';
        box.innerHTML = '';
        if (!q) return;
        assignableTeams
            .filter(t => t.name.toLowerCase().startsWith(q))
            .sort((a, b) => (a.group ? 1 : 0) - (b.group ? 1 : 0)) // Teams ohne Gruppe zuerst
            .slice(0, 20)
            .forEach(t => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action';
            btn.textContent = t.name + ' (' + (t.group || 'keine Gruppe') + ')';
            btn.addEventListener('click', function () {
                input.value = t.name;
                idField.value = t.id;
                box.innerHTML = '';
                const sel = document.getElementById('assignGroup');
                if (t.group && Array.from(sel.options).some(o => o.value === t.group)) sel.value = t.group;
            });
            box.appendChild(btn);
        });
    }
    input.addEventListener('input', render);
    document.addEventListener('click', function (e) {
        if (e.target !== input) box.innerHTML = '';
    });
});
</script>

<div class="container-fluid text-center">
    <hr>
    <h2 >Liste der Teams:</h2>
    <h8>Durch klicken auf eine Spaltenüberschrift, kann die Tabelle sortiert werden.</h8>
    <table class="table table-bordered table-responsive table-striped table-hover" id="teamTable">
        <thead>
            <tr style="background-color: #f2f2f2;">
                <th style="text-align: center;" rowspan="2" onclick="sortTable(0)">Index</th>
                <th style="text-align: center;" onclick="sortTable(1)">Name</th>
                <th style="text-align: center;" onclick="sortTable(2)">Gruppe</th>
                <th style="text-align: center;" rowspan="2" onclick="sortTable(3)">Zugangscode</th>
                <th style="text-align: center;" rowspan="2" onclick="sortTable(4)">Spiele gespielt</th>
                <th style="text-align: center;" rowspan="2" onclick="sortTable(5)">Spiele gewonnen</th>
                <th style="text-align: center;" rowspan="2" onclick="sortTable(6)">Spiele verloren</th>
                <th style="text-align: center;" rowspan="2" onclick="sortTable(7)">Spiele unentsch.</th>
                <th colspan="3" style="text-align: center;">Spiele in der Gruppenphase</th>
                <th style="text-align: center;"  rowspan="2" onclick="sortTable(11)">Sekt gewonnen</th>
                <th colspan="3" style="text-align: center;">Spiele im Tunier</th>
                <th	style="text-align: center;" rowspan="2" onclick="sortTable(15)">Tunier Rang</th></th>
                <th style="text-align: center;" rowspan="2" onclick="sortTable(16)">Foto</th>
                <th style="text-align: center;" rowspan="2">Aktionen</th>
            </tr>
            <tr style="background-color: #f2f2f2;">
                <th style="text-align: center;"><input type="text" id="nameFilter" onkeyup="filterTable(0)" placeholder="Filter Name"></th>
                <th style="text-align: center;"><input type="text" id="groupFilter" onkeyup="filterTable(1)" placeholder="Filter Gruppe" style="width: 100px;"></th>
                
                <th style="text-align: center;" onclick="sortTable(8)">Tore</th>
                <th style="text-align: center;" onclick="sortTable(9)">Tordifferenz</th>
                <th style="text-align: center;" onclick="sortTable(10)">Punkte</th>
                
                <th style="text-align: center;" onclick="sortTable(12)">Tore</th>
                <th style="text-align: center;" onclick="sortTable(13)">Tordifferenz</th>
                <th style="text-align: center;" onclick="sortTable(14)">Punkte Gesamt</th>
            </tr>
        </thead>
        <tbody>
            {{#each list}}
            <tr>
                <td>{{this.index}}</td>
                <td><strong>{{this.name}}</strong></td>
                <td>{{this.group}}</td>
                <td><strong>{{this.accessCode}}</strong></td>
                <td>{{this.gamesPlayed}}</td>
                <td>{{this.gamesWon}}</td>
                <td>{{this.gamesLost}}</td>
                <td>{{this.gamesDraw}}</td>
                <td><strong>{{this.goalsGroupStage.[0]}}</strong>:{{this.goalsGroupStage.[1]}}</td>
                <td>{{this.goalsDifferenceGroupStage}}</td>
                <td>{{this.points_Group_Stage}}</td>
                <td>{{this.sektWon}}</td>
                <td><strong>{{this.goals.[0]}}</strong>:{{this.goals.[1]}}</td>
                <td>{{this.goalsDifference}}</td>
                <td>{{this.points_General}}</td>
                <td>{{this.rank}}</td>
                <td>{{#if this.imagePath}}Ja{{else}}Nein{{/if}}</td>
                <td>
                    <a href="/team/details/{{this.id}}" class="btn btn-primary" role="button">Details</a>
                    <a href="/team/delete/{{this.id}}" onclick="return confirm('Bist du sicher, dass du das Team ' + '{{this.name}}' + ' löschen möchtest?');" class="btn btn-danger" role="button">Löschen</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <a href="/team/createMultiple" onclick="return chooseTeamCreationMode();" class="btn btn-danger mt-3" role="button">Erstelle 16 Teams</a>
    <a href="/team/deleteAll" onclick="return confirm('Sind Sie sicher, dass Sie alle Teams löschen möchten?');" class="btn btn-danger mt-3" role="button">Alle Teams löschen</a>
    <a href="/team/clearTeamCounters" onclick="return confirm('Are you sure you want to clear all team counters?');" class="btn btn-primary mt-3" role="button">Clear All Team Counters</a>
    <a href="/team/downloadAccessCodesCSV" class="btn btn-success mt-3" role="button">Zugangscodes herunterladen</a>
        <a href="/team/downloadTeamListCSV" onclick="return downloadTeamList(this);" class="btn btn-success mt-3" role="button">Teamliste als CSV herunterladen</a>    
</div>

<script>
function downloadTeamList(link) {
    const withRanks = confirm('Teamliste mit Platzierungen herunterladen?\nOK = mit Platzierungen, Abbrechen = ohne Platzierungen');
    window.location.href = '/team/downloadTeamListCSV?withRanks=' + (withRanks ? '1' : '0');
    return false;
}

function chooseTeamCreationMode() {
    const choice = prompt('Wie sollen die 16 Teams erstellt werden?\n1 = Mit den vorhandenen Gruppen\n2 = Ohne Gruppe (None)');
    if (choice === null) return false;
    const mode = choice.trim() === '1' ? 'groups' : choice.trim() === '2' ? 'none' : null;
    if (!mode) {
        alert('Bitte 1 für Teams mit Gruppen oder 2 für Teams ohne Gruppe eingeben.');
        return false;
    }
    if (!confirm('Sind Sie sicher, dass Sie 16 Teams ' + (mode === 'none' ? 'ohne Gruppe' : 'mit Gruppen') + ' erstellen möchten?')) {
        return false;
    }
    window.location.href = '/team/createMultiple?groupMode=' + mode;
    return false;
}

let sortDirections = [true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, true]; // Track sort directions for each column

function validateForm() {
    const name = document.getElementById('name').value.trim();
    const group = document.getElementById('group').value;
    if (!name) {
        alert('Bitte geben Sie einen Namen ein.');
        return false;
    }
    return true;
}

document.getElementById('group').addEventListener('change', function() {
    localStorage.setItem('selectedGroup', this.value); // Save selected group to localStorage
});

document.addEventListener('DOMContentLoaded', function() {
    const savedGroup = localStorage.getItem('selectedGroup');
    if (savedGroup) {
        document.getElementById('group').value = savedGroup;
        const event = new Event('change');
        document.getElementById('group').dispatchEvent(event); // Trigger change event to handle new group input display
    }
});

function sortTable(columnIndex) {
    const table = document.getElementById("teamTable");
    const rows = Array.from(table.rows).slice(2); // Skip header rows
    const isNumericColumn = columnIndex === 0 || (columnIndex >= 4 && columnIndex <= 15); // Check if the column is numeric
    const direction = sortDirections[columnIndex] ? 1 : -1; // Determine sort direction 
    const sortedRows = rows.sort((a, b) => {
        const cellA = isNumericColumn ? parseFloat(a.cells[columnIndex].innerText) : a.cells[columnIndex].innerText.toLowerCase();
        const cellB = isNumericColumn ? parseFloat(b.cells[columnIndex].innerText) : b.cells[columnIndex].innerText.toLowerCase();
        if (isNumericColumn) {
            // Handle NaN values (null or empty cells)
            const isNaNA = isNaN(cellA);
            const isNaNB = isNaN(cellB);
            
            if (isNaNA && isNaNB) return 0; // Both are NaN, treat as equal
            if (isNaNA) return 1; // A is NaN, put it after B
            if (isNaNB) return -1; // B is NaN, put it after A
            
            return direction * (cellA - cellB);
        } else {
            if (cellA < cellB) return -1 * direction;
            if (cellA > cellB) return 1 * direction;
            return 0;
        }
    });
    sortedRows.forEach(row => table.tBodies[0].appendChild(row));
    sortDirections[columnIndex] = !sortDirections[columnIndex]; // Toggle sort direction
}

function filterTable(columnIndex) {
    const input = document.getElementById(["nameFilter", "groupFilter"][columnIndex]);
    const filter = input.value.toLowerCase();
    const table = document.getElementById("teamTable");
    const rows = table.tBodies[0].rows;
    for (let i = 0; i < rows.length; i++) {
        const cellText = rows[i].cells[columnIndex+1].innerText.toLowerCase();
        rows[i].style.display = cellText.includes(filter) ? "" : "none";
    }
}

function validateMultipleTeamsForm() {
    const teamCount = document.getElementById('teamCount').value;
    if (teamCount < 1) {
        alert('Bitte geben Sie eine gültige Anzahl von Teams ein.');
        return false;
    }
    return true;
}

</script>
